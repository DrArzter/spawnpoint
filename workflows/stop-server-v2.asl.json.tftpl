{
  "Comment": "Lifecycle V2 stop wrapper: fence the exact session across player recheck, backup verification and EC2 stop.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Report Accepted",
  "States": {
    "Report Accepted": {
      "Type": "Task",
      "Comment": "The run's record: accepted, and running (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": "{% ($f := $merge([{'operation_id': {'S': $states.context.Execution.Name}, 'execution_arn': {'S': $states.context.Execution.Id}, 'type': {'S': 'stop'}, 'workflow': {'S': 'stop'}, 'status': {'S': 'running'}, 'root_id': {'S': ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name)}, 'started_at': {'S': $states.context.Execution.StartTime}, 'updated_at': {'S': $states.context.State.EnteredTime}, 'open_key': {'S': 'open'}, 'expires_at': {'N': $string($floor($toMillis($states.context.Execution.StartTime) / 1000) + 2592000)}, 'step': {'S': 'stop.checking'}}, $type($states.context.Execution.Input.worldId) = 'string' ? {'world_id': {'S': $states.context.Execution.Input.worldId}} : {}, $type($states.context.Execution.Input.gameId) = 'string' ? {'game_id': {'S': $states.context.Execution.Input.gameId}} : {}, $type($states.context.Execution.Input.serverId) = 'string' ? {'server_id': {'S': $states.context.Execution.Input.serverId}} : {}, $type($states.context.Execution.Input.operationParent) = 'string' ? {'parent_id': {'S': $states.context.Execution.Input.operationParent}} : {}]); {'TableName': '${operation_table_name}', 'Key': {'pk': {'S': 'OPERATION#' & $states.context.Execution.Name}, 'sk': {'S': 'RECORD'}}, 'UpdateExpression': 'SET ' & $join($map($keys($f), function($k) { '#' & $k & ' = :' & $k }), ', '), 'ExpressionAttributeNames': $merge($map($keys($f), function($k) { {'#' & $k: $k} })), 'ExpressionAttributeValues': $merge($map($keys($f), function($k) { {':' & $k: $lookup($f, $k)} }))}) %}",
      "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" }, "Output": "{% $states.input %}", "Next": "Route Operation Parent" }],
      "Next": "Route Operation Parent"
    },
    "Route Operation Parent": {
      "Type": "Choice",
      "Comment": "A nested run names itself on its parent's record (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Choices": [{ "Condition": "{% $type($states.context.Execution.Input.operationParent) = 'string' %}", "Next": "Report Child To Parent" }],
      "Default": "Initialize",
      "Output": "{% $states.input %}"
    },
    "Report Child To Parent": {
      "Type": "Task",
      "Comment": "The parent's record names its newest nested run (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Input.operationParent %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #child_id = :child_id, #updated_at = :updated_at",
        "ExpressionAttributeNames": { "#child_id": "child_id", "#updated_at": "updated_at" },
        "ExpressionAttributeValues": { ":child_id": { "S": "{% $states.context.Execution.Name %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Initialize" }],
      "Next": "Initialize"
    },
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "defaults": { "players": "refuse" },
        "coordination": {},
        "sessionVolume": {
          "mode": "${session_volume}",
          "volumeId": "",
          "createPolls": { "count": 0 },
          "attachPolls": { "count": 0 },
          "unmountPolls": { "count": 0 },
          "detachPolls": { "count": 0 }
        }
      },
      "Next": "Apply Request Defaults"
    },
    "Apply Request Defaults": {
      "Type": "Pass",
      "Comment": "A stop refuses while players are online unless its caller asks to disconnect them; the watchdog never does.",
      "Parameters": {
        "request.$": "States.JsonMerge($.defaults, $.request, false)",
        "coordination.$": "$.coordination",
        "sessionVolume.$": "$.sessionVolume"
      },
      "Next": "Read Lifecycle"
    },
    "Read Lifecycle": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "get",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "record.$": "$.Payload.record"
      },
      "ResultPath": "$.coordination.lifecycle",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Route Lifecycle"
    },
    "Route Lifecycle": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.coordination.lifecycle.record.desiredState", "StringEquals": "stopped" },
            { "Variable": "$.coordination.lifecycle.record.observedState", "StringEquals": "stopped" }
          ],
          "Next": "Already Stopped"
        },
        {
          "Variable": "$.coordination.lifecycle.record.activeSessionId",
          "StringEqualsPath": "$.request.sessionId",
          "Next": "Report Acquire Stop Lease"
        }
      ],
      "Default": "Report Stale Session"
    },
    "Report Acquire Stop Lease": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.locking" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Acquire Stop Lease" }],
      "Next": "Acquire Stop Lease"
    },
    "Acquire Stop Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "$.request.operationId",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Begin Stopping Session"
    },
    "Begin Stopping Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Report Find Placement"
    },
    "Report Find Placement": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.finding_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Find Placement" }],
      "Next": "Find Placement"
    },
    "Find Placement": {
      "Type": "Task",
      "Comment": "ADR-0054: a stop is told a session and finds its host and slot itself. ADR-0073: a lookup that keeps failing ends the stop; it never guesses a host.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "findPlacement",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placementLookup",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Placement Lookup Failed"
        }
      ],
      "Next": "Route Found Placement"
    },
    "Route Found Placement": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.placementLookup.placement",
          "IsNull": true,
          "Next": "Route Unplaced Session"
        }
      ],
      "Default": "Adopt Found Placement"
    },
    "Route Unplaced Session": {
      "Type": "Choice",
      "Comment": "ADR-0073: only a configured world runs on the configured host without a placement. A fleet world's record is its own (world#, ADR-0062), and a fleet session with no placement has no host that can verify its archive.",
      "Choices": [
        {
          "Variable": "$.request.serverId",
          "StringMatches": "world#*",
          "Next": "Report Mark Unplaced Session Stopped"
        }
      ],
      "Default": "Adopt Requested Host"
    },
    "Report Mark Unplaced Session Stopped": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Mark Unplaced Session Stopped" }],
      "Next": "Mark Unplaced Session Stopped"
    },
    "Mark Unplaced Session Stopped": {
      "Type": "Task",
      "Comment": "A fleet session with no placement never reached a host: its start reserves a placement before it runs anything there, and a stop releases the placement only after marking the session stopped. Nothing ran, so nothing needs archiving.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Release Unplaced Stop Lease"
    },
    "Release Unplaced Stop Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Report Fleet Session Unplaced"
    },
    "Adopt Found Placement": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.placementLookup.placement.hostId",
        "slot.$": "$.placementLookup.placement.slot"
      },
      "ResultPath": "$.request.placed",
      "Next": "Report Stop Accepted V1"
    },
    "Adopt Requested Host": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.request.instanceId",
        "slot": ""
      },
      "ResultPath": "$.request.placed",
      "Next": "Report Stop Accepted V1"
    },
    "Report Stop Accepted V1": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.saving" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Stop Accepted V1" }],
      "Next": "Stop Accepted V1"
    },
    "Stop Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-host-stop', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "players.$": "$.request.players",
          "timing.$": "$.request.stopTiming",
          "operationParent.$": "$$.Execution.Name",
          "operationRoot.$": "$operationRoot"
        }
      },
      "ResultPath": "$.hostStop",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.stopFailure",
          "Next": "Report Caught Before Route Stop Failure"
        }
      ],
      "Next": "Report Mark Session Stopped"
    },
    "Report Route Session Volume Release": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.releasing_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Session Volume Release" }],
      "Next": "Route Session Volume Release"
    },
    "Report Caught Before Route Session Volume Release": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionHistoryFailure.Error) = 'string' ? $substring($states.input.sessionHistoryFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionHistoryFailure.Cause) = 'string' ? $substring($states.input.sessionHistoryFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "stop.releasing_host" }, ":step": { "S": "stop.releasing_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Session Volume Release" }],
      "Next": "Route Session Volume Release"
    },
    "Route Session Volume Release": {
      "Type": "Choice",
      "Comment": "ADR-0102: the archive is verified and the session is already marked stopped, so the session volume is let go. Every failure below leaves the volume to the session volume sweeper and the stop goes on. The placement and the stop lease are released only after it, so no start or drain overlaps the release.",
      "Choices": [
        {
          "Variable": "$.sessionVolume.mode",
          "StringEquals": "enabled",
          "Next": "Find Session Volume"
        }
      ],
      "Default": "Report Release Placement"
    },
    "Find Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
      "Parameters": {
        "Filters": [
          {
            "Name": "tag:ManagedBy",
            "Values": [
              "${session_volume_managed_by}"
            ]
          },
          {
            "Name": "tag:${session_volume_session_tag}",
            "Values.$": "States.Array($.request.sessionId)"
          }
        ]
      },
      "ResultSelector": {
        "volumes.$": "$.Volumes"
      },
      "ResultPath": "$.sessionVolume.found",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Release Placement"
        }
      ],
      "Next": "Route Found Session Volume"
    },
    "Route Found Session Volume": {
      "Type": "Choice",
      "Comment": "A volume that is already available was detached by an earlier try. A host that keeps running for another session still has it mounted; a stopped host unmounted it when it shut down.",
      "Choices": [
        {
          "Variable": "$.sessionVolume.found.volumes[0]",
          "IsPresent": false,
          "Next": "Report Release Placement"
        },
        {
          "Variable": "$.sessionVolume.found.volumes[0].State",
          "StringEquals": "available",
          "Next": "Delete Session Volume"
        },
        {
          "Or": [
            { "Variable": "$.hostStop.Output.status", "StringEquals": "session_stopped_host_busy" },
            { "Variable": "$.hostStop.Output.status", "StringEquals": "session_stopped_spot_host" }
          ],
          "Next": "Unmount Session Volume"
        }
      ],
      "Default": "Detach Session Volume"
    },
    "Unmount Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-unmount-session-volume",
        "InstanceIds.$": "States.Array($.request.placed.hostId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)"
        },
        "TimeoutSeconds": 300,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultSelector": {
        "commandId.$": "$.Command.CommandId"
      },
      "ResultPath": "$.sessionVolume.unmount",
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Release Placement"
        }
      ],
      "Next": "Wait Before Unmount Poll"
    },
    "Wait Before Unmount Poll": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Get Unmount Command"
    },
    "Get Unmount Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
      "Parameters": {
        "CommandId.$": "$.sessionVolume.unmount.commandId",
        "InstanceId.$": "$.request.placed.hostId"
      },
      "ResultSelector": {
        "status.$": "$.Status"
      },
      "ResultPath": "$.sessionVolume.observed",
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Ssm.InvocationDoesNotExistException"
          ],
          "ResultPath": "$.sessionVolume.lookupError",
          "Next": "Report Caught Before Count Unmount Poll"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Release Placement"
        }
      ],
      "Next": "Unmount Complete"
    },
    "Unmount Complete": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.observed.status",
          "StringEquals": "Success",
          "Next": "Detach Session Volume"
        },
        {
          "Or": [
            {
              "Variable": "$.sessionVolume.observed.status",
              "StringEquals": "Pending"
            },
            {
              "Variable": "$.sessionVolume.observed.status",
              "StringEquals": "InProgress"
            },
            {
              "Variable": "$.sessionVolume.observed.status",
              "StringEquals": "Delayed"
            }
          ],
          "Next": "Count Unmount Poll"
        }
      ],
      "Default": "Report Release Placement"
    },
    "Report Caught Before Count Unmount Poll": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionVolume.lookupError.Error) = 'string' ? $substring($states.input.sessionVolume.lookupError.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionVolume.lookupError.Cause) = 'string' ? $substring($states.input.sessionVolume.lookupError.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "stop.releasing_host" }, ":step": { "S": "stop.releasing_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Count Unmount Poll" }],
      "Next": "Count Unmount Poll"
    },
    "Count Unmount Poll": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.sessionVolume.unmountPolls.count, 1)"
      },
      "ResultPath": "$.sessionVolume.unmountPolls",
      "Next": "Unmount Poll Limit Reached"
    },
    "Unmount Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.unmountPolls.count",
          "NumericGreaterThanEquals": 30,
          "Next": "Report Release Placement"
        }
      ],
      "Default": "Wait Before Unmount Poll"
    },
    "Detach Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:detachVolume",
      "Parameters": {
        "VolumeId.$": "$.sessionVolume.found.volumes[0].VolumeId",
        "InstanceId.$": "$.request.placed.hostId"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Release Placement"
        }
      ],
      "Next": "Wait Before Detach Poll"
    },
    "Wait Before Detach Poll": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Describe Detached Session Volume"
    },
    "Describe Detached Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
      "Parameters": {
        "VolumeIds.$": "States.Array($.sessionVolume.found.volumes[0].VolumeId)"
      },
      "ResultSelector": {
        "state.$": "$.Volumes[0].State"
      },
      "ResultPath": "$.sessionVolume.observed",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Release Placement"
        }
      ],
      "Next": "Session Volume Detached"
    },
    "Session Volume Detached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.observed.state",
          "StringEquals": "available",
          "Next": "Delete Session Volume"
        }
      ],
      "Default": "Count Detach Poll"
    },
    "Count Detach Poll": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.sessionVolume.detachPolls.count, 1)"
      },
      "ResultPath": "$.sessionVolume.detachPolls",
      "Next": "Detach Poll Limit Reached"
    },
    "Detach Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.detachPolls.count",
          "NumericGreaterThanEquals": 30,
          "Next": "Report Release Placement"
        }
      ],
      "Default": "Wait Before Detach Poll"
    },
    "Delete Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:deleteVolume",
      "Parameters": {
        "VolumeId.$": "$.sessionVolume.found.volumes[0].VolumeId"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Release Placement"
        }
      ],
      "Next": "Report Release Placement"
    },
    "Report Mark Session Stopped": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Mark Session Stopped" }],
      "Next": "Mark Session Stopped"
    },
    "Mark Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Close Session History"
    },
    "Close Session History": {
      "Type": "Task",
      "Comment": "Ends the session in the metrics history (ADR-0015). Best effort: a missed close is ended by the next session or by the stop time.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "closeSessionHistory",
          "worldId.$": "$.request.worldId",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.sessionHistoryFailure",
          "Next": "Report Caught Before Route Session Volume Release"
        }
      ],
      "Next": "Report Route Session Volume Release"
    },
    "Report Release Placement": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Placement" }],
      "Next": "Release Placement"
    },
    "Report Caught Before Release Placement": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionVolumeFailure.Error) = 'string' ? $substring($states.input.sessionVolumeFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionVolumeFailure.Cause) = 'string' ? $substring($states.input.sessionVolumeFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "stop.recording" }, ":step": { "S": "stop.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Placement" }],
      "Next": "Release Placement"
    },
    "Release Placement": {
      "Type": "Task",
      "Comment": "Placement bookkeeping (ADR-0054, phase 5): the session's reservation leaves the host record. Releasing what was never reserved is not a failure, and nothing acts on the drain that follows yet.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releasePlacement",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": {
        "released.$": "$.Payload.released",
        "host.$": "$.Payload.host"
      },
      "ResultPath": "$.placementRelease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Release Stop Lease"
        }
      ],
      "Next": "Report Route Emptied Host"
    },
    "Report Route Emptied Host": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.releasing_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Emptied Host" }],
      "Next": "Route Emptied Host"
    },
    "Route Emptied Host": {
      "Type": "Choice",
      "Comment": "ADR-0054: the host's half of the two-level stop. A launched host this stop emptied gets a drain; the configured host is stopped by the V1 stop as it always was, and a host that still holds sessions is left alone.",
      "Choices": [
        {
          "Variable": "$.placementRelease.host",
          "IsNull": true,
          "Next": "Report Release Stop Lease"
        }
      ],
      "Default": "Route Emptied Host State"
    },
    "Route Emptied Host State": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.placementRelease.host.record.state", "StringEquals": "draining" },
            { "Variable": "$.placementRelease.host.record.provenance", "StringEquals": "launched" }
          ],
          "Next": "Start Drain"
        }
      ],
      "Default": "Report Release Stop Lease"
    },
    "Start Drain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${drain_state_machine_arn}",
        "Name.$": "States.Format('{}-drain', $.request.operationId)",
        "Input": {
          "hostId.$": "$.placementRelease.host.record.hostId",
          "emptiedBy.$": "$.request.sessionId"
        }
      },
      "ResultPath": "$.drain",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.drainStartFailure",
          "Next": "Report Caught Before Release Stop Lease 2"
        }
      ],
      "Next": "Report Release Stop Lease"
    },
    "Report Caught Before Release Stop Lease": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.placementFailure.Error) = 'string' ? $substring($states.input.placementFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.placementFailure.Cause) = 'string' ? $substring($states.input.placementFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "stop.recording" }, ":step": { "S": "stop.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Stop Lease" }],
      "Next": "Release Stop Lease"
    },
    "Report Release Stop Lease": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Stop Lease" }],
      "Next": "Release Stop Lease"
    },
    "Report Caught Before Release Stop Lease 2": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.drainStartFailure.Error) = 'string' ? $substring($states.input.drainStartFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.drainStartFailure.Cause) = 'string' ? $substring($states.input.drainStartFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "stop.recording" }, ":step": { "S": "stop.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Stop Lease" }],
      "Next": "Release Stop Lease"
    },
    "Release Stop Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Stopped"
    },
    "Report Caught Before Route Stop Failure": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.stopFailure.Error) = 'string' ? $substring($states.input.stopFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.stopFailure.Cause) = 'string' ? $substring($states.input.stopFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "stop.cancelling" }, ":step": { "S": "stop.cancelling" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Stop Failure" }],
      "Next": "Route Stop Failure"
    },
    "Route Stop Failure": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.stopFailure.Cause",
          "StringMatches": "*Spawnpoint.PlayersOnline*",
          "Next": "Cancel Refused Stop"
        }
      ],
      "Default": "Report Verified Stop Failed"
    },
    "Cancel Refused Stop": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "cancelStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Release Refused Stop Lease"
    },
    "Release Refused Stop Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Report Stop Refused Players Online"
    },
    "Report Stop Refused Players Online": {
      "Type": "Task",
      "Comment": "The record ends as failed (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #error = :error, #cause = :cause, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#error": "error", "#cause": "cause", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "failed" }, ":error": { "S": "Spawnpoint.V2StopRefusedPlayersOnline" }, ":cause": { "S": "A player joined during the final recheck; the exact session returned to ready and its idle streak was reset." }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Stop Refused Players Online" }],
      "Next": "Stop Refused Players Online"
    },
    "Stop Refused Players Online": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StopRefusedPlayersOnline",
      "Cause": "A player joined during the final recheck; the exact session returned to ready and its idle streak was reset."
