{
  "Comment": "Lifecycle V2 start wrapper: fence one session, delegate host work to accepted V1, and compensate a failed start.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Initialize",
  "States": {
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "coordination": {
          "forcedStopPolls": 0
        }
      },
      "Next": "Initialize Lifecycle"
    },
    "Initialize Lifecycle": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "initialize",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Acquire Start Lease"
    },
    "Acquire Start Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "$.request.operationId",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Next": "Begin Session"
    },
    "Begin Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginSession",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId"
        }
      },
      "ResultPath": null,
      "Next": "Route Placement Mode"
    },
    "Route Placement Mode": {
      "Type": "Choice",
      "Comment": "ADR-0054. `single` starts the configured instance. `shared` registers it before placement. `fleet` excludes it and reuses or launches only ephemeral hosts, so portable worlds scale to zero.",
      "Choices": [
        {
          "Variable": "$.request.placement",
          "StringEquals": "fleet",
          "Next": "Place Fleet Session"
        },
        {
          "Variable": "$.request.placement",
          "StringEquals": "shared",
          "Next": "Describe Configured Host"
        }
      ],
      "Default": "Adopt Configured Host"
    },
    "Adopt Configured Host": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.request.instanceId",
        "slot": ""
      },
      "ResultPath": "$.request.placed",
      "Next": "Start Accepted V1"
    },
    "Place Fleet Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "placeSession",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "serverId.$": "$.request.serverId",
          "eligibleProvenance": "launched"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Route Placement"
    },
    "Describe Configured Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultSelector": {
        "instanceType.$": "$.Reservations[0].Instances[0].InstanceType"
      },
      "ResultPath": "$.host",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Describe Configured Host Shape"
    },
    "Describe Configured Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.host.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.host.shape",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Register Configured Host"
    },
    "Register Configured Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.request.instanceId",
          "ready": true,
          "shape": {
            "instanceType.$": "$.host.instanceType",
            "memoryMiB.$": "$.host.shape.memoryMiB",
            "vcpu.$": "$.host.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Place Session"
    },
    "Place Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "placeSession",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Route Placement"
    },
    "Route Placement": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.placement.placement.kind",
          "StringEquals": "reuse",
          "Next": "Adopt Placement"
        },
        {
          "And": [
            { "Variable": "$.placement.placement.kind", "StringEquals": "launch" },
            { "Variable": "$.request.launch", "StringEquals": "enabled" }
          ],
          "Next": "Launch Host"
        }
      ],
      "Default": "No Host Has Room"
    },
    "Launch Host": {
      "Type": "Task",
      "Comment": "ADR-0054, phase 12: an instant Fleet for exactly what the footprint needs. EC2 answers with the cheapest type in the allowed families; no type and no price lives here.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createFleet",
      "Parameters": {
        "Type": "instant",
        "LaunchTemplateConfigs": [
          {
            "LaunchTemplateSpecification": {
              "LaunchTemplateName": "${fleet_launch_template_name}",
              "Version": "$Latest"
            },
            "Overrides": [
              {
                "InstanceRequirements": {
                  "MemoryMiB": { "Min.$": "$.placement.placement.requirements.memoryMiB" },
                  "VCpuCount": { "Min.$": "$.placement.placement.requirements.vcpu" },
                  "AllowedInstanceTypes": ${allowed_instance_types},
                  "BurstablePerformance": "excluded"
                }
              }
            ]
          }
        ],
        "TargetCapacitySpecification": {
          "TotalTargetCapacity": 1,
          "DefaultTargetCapacityType": "on-demand"
        },
        "OnDemandOptions": {
          "AllocationStrategy": "lowest-price",
          "SingleInstanceType": true
        },
        "TagSpecifications": [
          {
            "ResourceType": "instance",
            "Tags": [
              { "Key": "AppCommit", "Value.$": "$.request.appCommit" },
              { "Key": "LaunchedFor", "Value.$": "$.request.sessionId" }
            ]
          }
        ]
      },
      "ResultSelector": {
        "instanceId.$": "$.Instances[0].InstanceIds[0]",
        "instanceType.$": "$.Instances[0].InstanceType"
      },
      "ResultPath": "$.launched",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Describe Launched Host Shape"
    },
    "Describe Launched Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.launched.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.launched.shape",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Terminate Unreserved Host"
        }
      ],
      "Next": "Register Launched Host"
    },
    "Register Launched Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.launched.instanceId",
          "ready": true,
          "provenance": "launched",
          "shape": {
            "instanceType.$": "$.launched.instanceType",
            "memoryMiB.$": "$.launched.shape.memoryMiB",
            "vcpu.$": "$.launched.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Terminate Unreserved Host"
        }
      ],
      "Next": "Reserve On Launched Host"
    },
    "Reserve On Launched Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "reserveOnHost",
          "hostId.$": "$.launched.instanceId",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Terminate Unreserved Host"
        }
      ],
      "Next": "Adopt Placement"
    },
    "Terminate Unreserved Host": {
      "Type": "Task",
      "Comment": "A host launched for this session that could not be recorded or reserved is let go at once, before it can be billed for an evening nobody knows about.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:terminateInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.launched.instanceId)"
      },
      "ResultPath": "$.unreservedTermination",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.unreservedTerminationFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Placement Unavailable"
    },
    "Adopt Placement": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.placement.placement.hostId",
        "slot.$": "$.placement.placement.slot"
      },
      "ResultPath": "$.request.placed",
      "Next": "Start Accepted V1"
    },
    "No Host Has Room": {
      "Type": "Pass",
      "Comment": "The coordinator answered with what to launch and launching is disabled, or the world is bound to the configured host and that host has no room (ADR-0054). The session is cancelled cleanly rather than started on a host that has no room for it.",
      "Result": { "reason": "no_host_has_room" },
      "ResultPath": "$.placementRefusal",
      "Next": "Begin Cancelling Unplaced Session"
    },
    "Placement Unavailable": {
      "Type": "Pass",
      "Result": { "reason": "placement_unavailable" },
      "ResultPath": "$.placementRefusal",
      "Next": "Begin Cancelling Unplaced Session"
    },
    "Begin Cancelling Unplaced Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Mark Unplaced Session Stopped"
    },
    "Mark Unplaced Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Unplaced Lease"
    },
    "Release Unplaced Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Start Refused Unplaced"
    },
    "Start Refused Unplaced": {
      "Type": "Fail",
      "Error": "Spawnpoint.SessionUnplaced",
      "Cause": "No registered host has room for this session and launching one is disabled or failed, or the world is bound to the configured host, or the placement could not be read. Nothing was started; the session was cancelled and its lease released."
    },
    "Start Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${start_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-host-start', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "placement.$": "$.request.placement",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.startTiming"
        }
      },
      "ResultPath": "$.hostStart",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.startFailure",
          "Next": "Begin Compensating Stop"
        }
      ],
      "Next": "Route Bookkeeping"
    },
    "Route Bookkeeping": {
      "Type": "Choice",
      "Comment": "Shared and Fleet sessions already reserved their actual host. Only single mode records the configured host and slot zero after the fact.",
      "Choices": [
        {
          "Variable": "$.request.placement",
          "StringEquals": "shared",
          "Next": "Mark Session Ready"
        },
        {
          "Variable": "$.request.placement",
          "StringEquals": "fleet",
          "Next": "Mark Session Ready"
        }
      ],
      "Default": "Describe Host"
    },
    "Describe Host": {
      "Type": "Task",
      "Comment": "Single-mode bookkeeping: record the configured host and slot zero. A Fleet session must never reserve this unrelated instance.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultSelector": {
        "instanceType.$": "$.Reservations[0].Instances[0].InstanceType"
      },
      "ResultPath": "$.host",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Describe Host Shape"
    },
    "Describe Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.host.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.host.shape",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Register Host"
    },
    "Register Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.request.instanceId",
          "ready": true,
          "shape": {
            "instanceType.$": "$.host.instanceType",
            "memoryMiB.$": "$.host.shape.memoryMiB",
            "vcpu.$": "$.host.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Reserve Slot Zero"
    },
    "Reserve Slot Zero": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "reserveOnHost",
          "hostId.$": "$.request.instanceId",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Mark Session Ready"
    },
    "Mark Session Ready": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markSessionReady",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId",
          "connectionAddress.$": "$.hostStart.Output.connectionAddress"
        }
      },
      "ResultPath": null,
      "Next": "Release Start Lease"
    },
    "Release Start Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Start Session Watchdog"
    },
    "Start Session Watchdog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${watchdog_state_machine_arn}",
        "Name.$": "States.Format('{}-watchdog', $.request.operationId)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-watchdog', $.request.operationId)",
          "sessionId.$": "$.request.sessionId",
          "registrationLeaseTtlSeconds.$": "$.request.watchdogRegistrationLeaseTtlSeconds",
          "stopLeaseTtlSeconds.$": "$.request.watchdogStopLeaseTtlSeconds",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.watchdogTiming",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.watchdog",
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.watchdogFailure",
        "Next": "Acquire Watchdog Compensation Lease"
      }],
      "Next": "Ready"
    },
    "Acquire Watchdog Compensation Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-watchdog-compensation', $.request.operationId)",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Next": "Begin Compensating Stop"
    },
    "Ready": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "serverId.$": "$.request.serverId",
        "status": "ready",
        "connectivity.$": "$.hostStart.Output.connectivity",
        "connectionAddress.$": "$.hostStart.Output.connectionAddress",
        "hostStart.$": "$.hostStart.Output"
      },
      "End": true
    },
    "Begin Compensating Stop": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Stop Accepted V1"
    },
    "Stop Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-compensate', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.hostStop",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.stopFailure",
          "Next": "Force Stop Failed Start Host"
        }
      ],
      "Next": "Mark Compensated Session Stopped"
    },
    "Force Stop Failed Start Host": {
      "Type": "Task",
      "Comment": "The verified stop could not run because the game never became healthy enough to save or probe. Stop the billed host as the final cost-safety boundary; the persistent volume remains attached for recovery.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultPath": "$.coordination.forcedStopRequest",
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.forcedStopFailure",
        "Next": "Start Compensation Failed"
      }],
      "Next": "Wait Before Forced Stop Poll"
    },
    "Wait Before Forced Stop Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.stopTiming.instancePollSeconds",
      "Next": "Describe Forced Stop Host"
    },
    "Describe Forced Stop Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultPath": "$.coordination.forcedStopInstance",
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.forcedStopFailure",
        "Next": "Start Compensation Failed"
      }],
      "Next": "Forced Stop Host Stopped"
    },
    "Forced Stop Host Stopped": {
      "Type": "Choice",
      "Choices": [{
        "Variable": "$.coordination.forcedStopInstance.Reservations[0].Instances[0].State.Name",
        "StringEquals": "stopped",
        "Next": "Mark Forced Session Stopped"
      }],
      "Default": "Increment Forced Stop Poll"
    },
    "Increment Forced Stop Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "coordination": {
          "lease.$": "$.coordination.lease",
          "forcedStopPolls.$": "States.MathAdd($.coordination.forcedStopPolls, 1)"
        },
        "startFailure.$": "$.startFailure",
        "stopFailure.$": "$.stopFailure"
      },
      "Next": "Forced Stop Poll Limit Reached"
    },
    "Forced Stop Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [{
        "Variable": "$.coordination.forcedStopPolls",
        "NumericGreaterThanEqualsPath": "$.request.stopTiming.maxInstancePolls",
        "Next": "Start Compensation Failed"
      }],
      "Default": "Wait Before Forced Stop Poll"
    },
    "Mark Forced Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Forced Placement"
    },
    "Release Forced Placement": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releasePlacement",
          "hostId.$": "$.request.placed.hostId",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": { "host.$": "$.Payload.host" },
      "ResultPath": "$.placementRelease",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.placementReleaseError", "Next": "Release Forced Compensation Lease" }],
      "Next": "Release Forced Compensation Lease"
    },
    "Release Forced Compensation Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Route Forced Fleet Drain"
    },
    "Route Forced Fleet Drain": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.placementReleaseError", "IsPresent": true, "Next": "Start Compensation Host Not Drained" },
        {
          "And": [
            { "Variable": "$.placementRelease.host.record.state", "StringEquals": "draining" },
            { "Variable": "$.placementRelease.host.record.provenance", "StringEquals": "launched" }
          ],
          "Next": "Start Forced Host Drain"
        }
      ],
      "Default": "Start Failed Host Forced Stopped"
    },
    "Start Forced Host Drain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${drain_state_machine_arn}",
        "Name.$": "States.Format('{}-failed-start-drain', $.request.operationId)",
        "Input": {
          "hostId.$": "$.request.placed.hostId",
          "emptiedBy.$": "$.request.sessionId",
          "immediate": true
        }
      },
      "ResultPath": "$.drain",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.drainStartFailure", "Next": "Start Compensation Host Not Drained" }],
      "Next": "Start Failed Host Forced Stopped"
    },
    "Start Failed Host Forced Stopped": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartFailedHostForcedStopped",
      "Cause": "The host start and verified stop both failed; EC2 was forcibly stopped and its persistent volume was retained for recovery."
    },
    "Mark Compensated Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Compensated Placement"
    },
    "Release Compensated Placement": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releasePlacement",
          "hostId.$": "$.request.placed.hostId",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": { "host.$": "$.Payload.host" },
      "ResultPath": "$.placementRelease",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.placementReleaseError", "Next": "Release Compensating Lease" }],
      "Next": "Release Compensating Lease"
    },
    "Release Compensating Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Route Compensated Fleet Drain"
    },
    "Route Compensated Fleet Drain": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.placementReleaseError", "IsPresent": true, "Next": "Start Compensation Host Not Drained" },
        {
          "And": [
            { "Variable": "$.placementRelease.host.record.state", "StringEquals": "draining" },
            { "Variable": "$.placementRelease.host.record.provenance", "StringEquals": "launched" }
          ],
          "Next": "Start Compensated Host Drain"
        }
      ],
      "Default": "Start Failed And Compensated"
    },
    "Start Compensated Host Drain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${drain_state_machine_arn}",
        "Name.$": "States.Format('{}-failed-start-drain', $.request.operationId)",
        "Input": {
          "hostId.$": "$.request.placed.hostId",
          "emptiedBy.$": "$.request.sessionId",
          "immediate": true
        }
      },
      "ResultPath": "$.drain",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.drainStartFailure", "Next": "Start Compensation Host Not Drained" }],
      "Next": "Start Failed And Compensated"
    },
    "Start Failed And Compensated": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartFailedCompensated",
      "Cause": "The host start or required watchdog launch failed; the host was stopped and lifecycle state returned to stopped."
    },
    "Start Compensation Failed": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartCompensationFailed",
      "Cause": "Host start, verified stop compensation and the final EC2 stop safeguard did not all complete; lifecycle remains stopping for explicit recovery and the running-hours alarm remains the backstop."
    },
    "Start Compensation Host Not Drained": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartHostNotDrained",
      "Cause": "The failed session was stopped, but its host reservation could not be released or the empty launched host could not be drained. The running-hours alarm remains the backstop."
    }
  }
}
