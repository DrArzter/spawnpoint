{
  "id": "palworld",
  "code": "PW",
  "display_name": "Palworld",
  "connect": {
    "port": 8211,
    "protocol": "udp"
  },
  "probe_port": 8212,
  "slottable": true,
  "default_auth": "none",
  "required_secrets": [
    "PALWORLD_ADMIN_PASSWORD"
  ],
  "footprint": {
    "memory_mib": 16384,
    "cores": 4
  },
  "capabilities": {
    "whitelist": false,
    "spot": false
  },
  "interruption": {
    "save": "live",
    "save_budget_seconds": 60
  },
  "console": {
    "lifecycle_commands": [
      "shutdown",
      "stop"
    ],
    "suggestions": [
      "metrics",
      "save",
      "announce Server stops in 5 minutes"
    ]
  }
}
