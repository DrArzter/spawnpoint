#!/usr/bin/env bash

set -Eeuo pipefail

: "${FAKE_S3_ROOT:?FAKE_S3_ROOT is required}"

while (( $# > 0 )); do
  case "$1" in
    --region | --endpoint-url | --profile)
      shift 2
      ;;
    --no-cli-pager)
      shift
      ;;
    *)
      break
      ;;
  esac
done

# FAKE_AWS_CALL_LOG records each call, so a test can count the requests.
[[ -z "${FAKE_AWS_CALL_LOG:-}" ]] || printf '%s\n' "$*" >>"${FAKE_AWS_CALL_LOG}"

# A DynamoDB table of one JSON object per item in FAKE_DDB_FILE, keyed `pk|sk`.
# FAKE_DDB_FAIL=true stands for a table the host may not write.
if [[ "${1:-}" == "dynamodb" ]]; then
  [[ "${FAKE_DDB_FAIL:-false}" != "true" ]] || exit 255
  : "${FAKE_DDB_FILE:?FAKE_DDB_FILE is required}"
  [[ -f "${FAKE_DDB_FILE}" ]] || printf '{}' >"${FAKE_DDB_FILE}"
  operation="${2:-}"
  shift 2
  key_json=""
  items_json=""
  while (( $# > 0 )); do
    case "$1" in
      --key) key_json="$2"; shift 2 ;;
      --transact-items) items_json="$2"; shift 2 ;;
      --table-name | --output) shift 2 ;;
      --consistent-read) shift ;;
      *) exit 64 ;;
    esac
  done
  case "${operation}" in
    get-item)
      slot="$(jq -r '.pk.S + "|" + .sk.S' <<<"${key_json}")"
      jq --arg slot "${slot}" 'if has($slot) then {Item: .[$slot]} else {} end' "${FAKE_DDB_FILE}"
      ;;
    transact-write-items)
      # A Put needs a free slot; an Update on the release item needs state live.
      state="$(jq -r '.[1].Update.Key.pk.S as $pk | .[1].Update.Key.sk.S as $sk | $pk + "|" + $sk' <<<"${items_json}")"
      jq -e --argjson items "${items_json}" --arg meta "${state}" '
        ($items[0].Put.Item.pk.S + "|" + $items[0].Put.Item.sk.S) as $slot
        | (has($slot) | not) and (.[$meta].state.S == "live")' "${FAKE_DDB_FILE}" >/dev/null || exit 254
      updated="$(jq --argjson items "${items_json}" --arg meta "${state}" '
        ($items[0].Put.Item.pk.S + "|" + $items[0].Put.Item.sk.S) as $slot
        | .[$slot] = $items[0].Put.Item
        | .[$meta].holders.N = ((.[$meta].holders.N | tonumber) + 1 | tostring)' "${FAKE_DDB_FILE}")"
      printf '%s' "${updated}" >"${FAKE_DDB_FILE}"
      ;;
    *) exit 64 ;;
  esac
  exit 0
fi

# `s3 cp --recursive s3://bucket/prefix/ dir/` with ordered --exclude and
# --include globs, the last match deciding, as the real CLI does.
if [[ "${1:-}" == "s3" ]]; then
  [[ "${2:-}" == "cp" ]] || exit 64
  shift 2
  recursive=false
  filters=()
  paths=()
  while (( $# > 0 )); do
    case "$1" in
      --recursive)
        recursive=true
        shift
        ;;
      --only-show-errors)
        shift
        ;;
      --exclude | --include)
        filters+=("$1" "$2")
        shift 2
        ;;
      --*)
        exit 64
        ;;
      *)
        paths+=("$1")
        shift
        ;;
    esac
  done
  [[ "${recursive}" == true && ${#paths[@]} -eq 2 && "${paths[0]}" == s3://* ]] || exit 64
  source_path="${paths[0]#s3://}"
  # FAKE_S3_CP_FAIL_PREFIX stands for a copy S3 refuses part way, for keys under that prefix.
  [[ -z "${FAKE_S3_CP_FAIL_PREFIX:-}" || "${source_path}" != *"/${FAKE_S3_CP_FAIL_PREFIX}"* ]] || exit 1
  source_root="${FAKE_S3_ROOT}/${source_path%/}"
  destination_root="${paths[1]%/}"
  [[ -d "${source_root}" ]] || exit 0
  while IFS= read -r relative; do
    included=true
    for ((index = 0; index < ${#filters[@]}; index += 2)); do
      # shellcheck disable=SC2053 # the filter is a glob on purpose
      if [[ "${relative}" == ${filters[index + 1]} ]]; then
        [[ "${filters[index]}" == --include ]] && included=true || included=false
      fi
    done
    [[ "${included}" == true ]] || continue
    mkdir -p -- "$(dirname -- "${destination_root}/${relative}")"
    cp -- "${source_root}/${relative}" "${destination_root}/${relative}"
  done < <(cd -- "${source_root}" && find . -type f ! -name '*.fake-metadata' -printf '%P\n' | sort)
  exit 0
fi

[[ "${1:-}" == "s3api" ]] || exit 64
operation="${2:-}"
shift 2

bucket=""
key=""
body=""
metadata=""
checksum=""
query=""
if_none_match=""
destination=""
prefix=""

while (( $# > 0 )); do
  case "$1" in
    --bucket)
      bucket="$2"
      shift 2
      ;;
    --key)
      key="$2"
      shift 2
      ;;
    --body)
      body="$2"
      shift 2
      ;;
    --metadata)
      metadata="$2"
      shift 2
      ;;
    --checksum-sha256)
      checksum="$2"
      shift 2
      ;;
    --if-none-match)
      if_none_match="$2"
      shift 2
      ;;
    --prefix)
      prefix="$2"
      shift 2
      ;;
    --query)
      query="$2"
      shift 2
      ;;
    --checksum-mode | --checksum-algorithm | --output | --server-side-encryption | --content-type)
      shift 2
      ;;
    --*)
      exit 64
      ;;
    *)
      destination="$1"
      shift
      ;;
  esac
done

object="${FAKE_S3_ROOT}/${bucket}/${key}"
metadata_file="${object}.fake-metadata"

case "${operation}" in
  put-object)
    [[ -z "${FAKE_S3_PUT_FAIL_KEY:-}" || "${key}" != "${FAKE_S3_PUT_FAIL_KEY}" ]] || exit 255
    [[ "${if_none_match}" != "*" || ! -f "${object}" ]] || exit 255
    # FAKE_S3_INFLIGHT_DIR makes puts overlap long enough to log how many ran
    # at once: one line per put in FAKE_S3_INFLIGHT_LOG.
    if [[ -n "${FAKE_S3_INFLIGHT_DIR:-}" ]]; then
      : >"${FAKE_S3_INFLIGHT_DIR}/$$"
      printf '%s\n' "$(find "${FAKE_S3_INFLIGHT_DIR}" -type f | wc -l)" >>"${FAKE_S3_INFLIGHT_LOG}"
      sleep "${FAKE_S3_PUT_SLEEP:-0.2}"
      rm -f -- "${FAKE_S3_INFLIGHT_DIR}/$$"
    fi
    mkdir -p -- "$(dirname -- "${object}")"
    cp -- "${body}" "${object}"
    if jq -e 'type == "object"' <<<"${metadata}" >/dev/null 2>&1; then
      printf 'sha256=%s,release=%s,file=%s\n' \
        "$(jq -r '.sha256' <<<"${metadata}")" \
        "$(jq -r '.release' <<<"${metadata}")" \
        "$(jq -r '.file' <<<"${metadata}")" >"${metadata_file}"
    else
      printf '%s\n' "${metadata}" >"${metadata_file}"
    fi
    printf '%s\n' "${checksum}" >>"${metadata_file}"
    if [[ "${query}" == VersionId ]]; then
      printf 'fake-version-%s\n' "$(cksum <<<"${key}" | cut -d' ' -f1)"
    fi
    # The real response carries ChecksumSHA256 once S3 validated the bytes.
    # FAKE_S3_PUT_BAD_RESPONSE_KEY stands for S3 answering with another digest.
    if [[ "${query}" == ChecksumSHA256 ]]; then
      if [[ -n "${FAKE_S3_PUT_BAD_RESPONSE_KEY:-}" && "${key}" == "${FAKE_S3_PUT_BAD_RESPONSE_KEY}" ]]; then
        printf '%s\n' "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
      else
        printf '%s\n' "${checksum}"
      fi
    fi
    ;;
  head-object)
    [[ -f "${object}" && -f "${metadata_file}" ]] || exit 254
    if [[ "${query}" == VersionId ]]; then
      printf 'fake-version-%s\n' "$(cksum <<<"${key}" | cut -d' ' -f1)"
      exit 0
    fi
    IFS=',' read -r sha_field _ <"${metadata_file}"
    stored_checksum="$(sed -n '2p' "${metadata_file}")"
    printf '%s\t%s\t%s\n' "${sha_field#sha256=}" "${stored_checksum}" "$(stat --format '%s' -- "${object}")"
    ;;
  get-object)
    if [[ ! -f "${object}" || -z "${destination}" ]]; then
      printf 'An error occurred (NoSuchKey) when calling the GetObject operation\n' >&2
      exit 254
    fi
    cp -- "${object}" "${destination}"
    # Objects placed directly into the fake bucket have no metadata sidecar.
    if [[ -f "${metadata_file}" ]]; then
      stored_checksum="$(sed -n '2p' "${metadata_file}")"
      jq -n --arg checksum "${stored_checksum}" '{ChecksumSHA256: $checksum}'
    else
      jq -n '{}'
    fi
    ;;
  delete-object)
    rm -f -- "${object}" "${metadata_file}"
    jq -n '{}'
    ;;
  list-objects-v2)
    # FAKE_S3_LIST_FAIL stands for a listing S3 refuses or never answers.
    [[ "${FAKE_S3_LIST_FAIL:-false}" != "true" ]] || exit 255
    root="${FAKE_S3_ROOT}/${bucket}"
    if [[ -d "${root}" ]]; then
      (cd -- "${root}" && find . -type f ! -name '*.fake-metadata' -printf '%P\t%s\n') | sort |
        jq -R --arg prefix "${prefix}" 'split("\t") | select(.[0] | startswith($prefix)) | {Key: .[0], Size: (.[1] | tonumber)}' |
        jq -s '{Contents: .}'
    else
      jq -n '{}'
    fi
    ;;
  *)
    exit 64
    ;;
esac
