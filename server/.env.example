# Copy to .env beside compose.yaml. .env is gitignored; this file is not.
CF_API_KEY=change-me
RCON_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
ZEROTIER_NETWORK_ID=change-me
ZEROTIER_ADDRESS=127.0.0.1
BACKUP_BUCKET=change-me
AWS_REGION=eu-central-1
# Prometheus has no login and always stays host-local. Grafana also defaults to
# loopback; set only its address to 0.0.0.0 for access through a zero-ingress
# EC2 security group plus the private ZeroTier network.
PROMETHEUS_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1
