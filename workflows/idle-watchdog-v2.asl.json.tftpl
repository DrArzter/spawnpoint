{
  "Comment": "Lifecycle V2 watchdog: register one execution per session, persist idempotent player observations, and stop only that session.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Initialize",
  "States": {
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "defaults": { "predecessorExecutionId": "" },
        "counters": { "total": 0, "probeFailures": 0, "stopRefusals": 0, "probePoll": 0 },
        "observed": {},
        "coordination": {}
      },
      "Next": "Apply Request Defaults"
    },
    "Apply Request Defaults": {
      "Type": "Pass",
      "Comment": "A watchdog started with its session names no predecessor. A relay names the execution it takes the session over from.",
      "Parameters": {
        "request.$": "States.JsonMerge($.defaults, $.request, false)",
        "counters.$": "$.counters",
        "observed.$": "$.observed",
        "coordination.$": "$.coordination"
      },
      "Next": "Acquire Registration Lease"
    },
    "Acquire Registration Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "$.request.operationId",
          "ttlSeconds.$": "$.request.registrationLeaseTtlSeconds"
        }
      },
      "ResultSelector": { "ownership.$": "$.Payload.ownership" },
      "ResultPath": "$.coordination.lease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Register This Watchdog"
    },
    "Register This Watchdog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerWatchdog",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId",
          "watchdogExecutionId.$": "$$.Execution.Id",
          "predecessorExecutionId.$": "$.request.predecessorExecutionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.coordination.registrationError",
          "Next": "Release Rejected Registration Lease"
        }
      ],
      "Next": "Release Registration Lease"
    },
    "Release Rejected Registration Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Watchdog Registration Rejected"
    },
    "Watchdog Registration Rejected": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2WatchdogRegistrationRejected",
      "Cause": "The session is stale, is not ready, or already owns a different watchdog; the rejected execution released its lease."
    },
    "Release Registration Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Wait Between Checks"
    },
    "Wait Between Checks": {
      "Type": "Wait",
      "SecondsPath": "$.request.timing.checkIntervalSeconds",
      "Next": "Describe Host"
    },
    "Describe Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": { "InstanceIds.$": "States.Array($.request.instanceId)" },
      "ResultPath": "$.observed.instance",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Comment": "A check that cannot see the host is a failed probe: it counts towards Watchdog Blind and never towards idle.",
          "ResultPath": "$.observed.probeError",
          "Next": "Record Synthetic Unknown"
        }
      ],
      "Next": "Host Still Running"
    },
    "Host Still Running": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
          "StringEquals": "running",
          "Next": "Route Probe Command"
        }
      ],
      "Default": "Read Session Before Reconcile"
    },
    "Read Session Before Reconcile": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "ADR-0102: a reclaimed Spot host is gone, but its session moves rather than stops. Only a watchdog that still owns a session that is not moving reconciles it.",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "get",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "observedState.$": "$.Payload.record.observedState",
        "activeSessionId.$": "$.Payload.record.activeSessionId",
        "idle.$": "$.Payload.record.idle",
        "self.$": "$$.Execution.Id"
      },
      "ResultPath": "$.observed.session",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Session Moving"
    },
    "Session Moving": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.session.observedState",
          "StringEquals": "moving",
          "Next": "Session Moved"
        },
        {
          "Variable": "$.observed.session.idle.watchdogExecutionId",
          "IsPresent": true,
          "Next": "Watchdog Still Owns Session"
        }
      ],
      "Default": "Session Moved"
    },
    "Watchdog Still Owns Session": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.session.idle.watchdogExecutionId",
          "StringEqualsPath": "$.observed.session.self",
          "Next": "Reconcile Externally Stopped Host"
        }
      ],
      "Default": "Session Moved"
    },
    "Session Moved": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "status": "session_moved",
        "checksTotal.$": "$.counters.total"
      },
      "End": true
    },
    "Route Probe Command": {
      "Type": "Choice",
      "Comment": "ADR-0054: a placed session is probed in its own Compose project and on its own RCON port, which its slot names.",
      "Choices": [
        {
          "Variable": "$.request.slot",
          "IsPresent": true,
          "Next": "Send Placed Probe"
        }
      ],
      "Default": "Send Structured Probe"
    },
    "Send Placed Probe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-session-activity",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)",
          "slot.$": "States.Array(States.Format('{}', $.request.slot))"
        },
        "TimeoutSeconds": 300
      },
      "ResultPath": "$.observed.command",
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.observed.probeError",
          "Next": "Record Synthetic Unknown"
        }
      ],
      "Next": "Wait Probe Result"
    },
    "Send Structured Probe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-session-activity",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)"
        },
        "TimeoutSeconds": 300
      },
      "ResultPath": "$.observed.command",
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.observed.probeError",
          "Next": "Record Synthetic Unknown"
        }
      ],
      "Next": "Wait Probe Result"
    },
    "Wait Probe Result": {
      "Type": "Wait",
      "SecondsPath": "$.request.timing.probePollSeconds",
      "Next": "Get Probe Result"
    },
    "Get Probe Result": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
      "Parameters": {
        "CommandId.$": "$.observed.command.Command.CommandId",
        "InstanceId.$": "$.request.instanceId"
      },
      "ResultPath": "$.observed.invocation",
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["Ssm.InvocationDoesNotExistException"],
          "ResultPath": "$.observed.lookupError",
          "Next": "Increment Probe Poll"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Comment": "A result that cannot be read is an unknown probe, as a failed command is. It never fails the watchdog and never counts as empty.",
          "ResultPath": "$.observed.probeError",
          "Next": "Record Command Unknown"
        }
      ],
      "Next": "Route Probe Result"
    },
    "Route Probe Result": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.invocation.Status",
          "StringEquals": "Success",
          "Next": "Parse Probe Output"
        },
        {
          "Or": [
            { "Variable": "$.observed.invocation.Status", "StringEquals": "Pending" },
            { "Variable": "$.observed.invocation.Status", "StringEquals": "InProgress" },
            { "Variable": "$.observed.invocation.Status", "StringEquals": "Delayed" }
          ],
          "Next": "Increment Probe Poll"
        }
      ],
      "Default": "Record Command Unknown"
    },
    "Increment Probe Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "counters": {
          "total.$": "$.counters.total",
          "probeFailures.$": "$.counters.probeFailures",
          "stopRefusals.$": "$.counters.stopRefusals",
          "probePoll.$": "States.MathAdd($.counters.probePoll, 1)"
        },
        "observed": { "command.$": "$.observed.command" },
        "coordination.$": "$.coordination"
      },
      "Next": "Probe Poll Limit Reached"
    },
    "Probe Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.counters.probePoll",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxProbePolls",
          "Next": "Record Command Unknown"
        }
      ],
      "Default": "Wait Probe Result"
    },
    "Parse Probe Output": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "counters.$": "$.counters",
        "coordination.$": "$.coordination",
        "observed": {
          "command.$": "$.observed.command",
          "probe.$": "States.StringToJson($.observed.invocation.StandardOutputContent)"
        }
      },
      "Next": "Extract Player Count"
    },
    "Extract Player Count": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "counters.$": "$.counters",
        "coordination.$": "$.coordination",
        "observed": {
          "command.$": "$.observed.command",
          "probe.$": "$.observed.probe",
          "playersOnline.$": "$.observed.probe.playersOnline"
        }
      },
      "Next": "Record Successful Observation"
    },
    "Record Successful Observation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "recordPlayerObservation",
          "serverId.$": "$.request.serverId",
          "sessionId.$": "$.request.sessionId",
          "watchdogExecutionId.$": "$$.Execution.Id",
          "observationId.$": "$.observed.command.Command.CommandId",
          "playersOnline.$": "$.observed.playersOnline"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Has Memory Reading"
    },
    "Has Memory Reading": {
      "Type": "Choice",
      "Comment": "A host that predates the memory probe reports none. That is no failure; it simply publishes nothing.",
      "Choices": [
        {
          "Variable": "$.observed.probe.memory.usedPercent",
          "IsPresent": true,
          "Next": "Publish Memory Reading"
        }
      ],
      "Default": "Count Successful Probe"
    },
    "Publish Memory Reading": {
      "Type": "Task",
      "Comment": "ADR-0015: EC2 has no memory metric, so the host's own figure is published for the panel to chart. Best effort: the player observation is already recorded, and a failure here never counts as a failed probe.",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:putMetricData",
      "Parameters": {
        "Namespace": "Spawnpoint/Host",
        "MetricData": [
          {
            "MetricName": "MemoryUsedPercent",
            "Dimensions": [{ "Name": "InstanceId", "Value.$": "$.request.instanceId" }],
            "Unit": "Percent",
            "Value.$": "$.observed.probe.memory.usedPercent"
          }
        ]
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "Count Successful Probe"
        }
      ],
      "Next": "Count Successful Probe"
    },
    "Count Successful Probe": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "counters": {
          "total.$": "States.MathAdd($.counters.total, 1)",
          "probeFailures": 0,
          "stopRefusals.$": "$.counters.stopRefusals",
          "probePoll": 0
        },
        "observed": {},
        "coordination.$": "$.coordination"
      },
      "Next": "Check Idle Eligibility"
    },
    "Record Command Unknown": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "recordPlayerObservation",
          "serverId.$": "$.request.serverId",
          "sessionId.$": "$.request.sessionId",
          "watchdogExecutionId.$": "$$.Execution.Id",
          "observationId.$": "$.observed.command.Command.CommandId",
          "playersOnline": null
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Count Probe Failure"
    },
    "Record Synthetic Unknown": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "recordPlayerObservation",
          "serverId.$": "$.request.serverId",
          "sessionId.$": "$.request.sessionId",
          "watchdogExecutionId.$": "$$.Execution.Id",
          "observationId.$": "States.Format('{}-send-failure-{}', $$.Execution.Id, $.counters.total)",
          "playersOnline": null
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Count Probe Failure"
    },
    "Count Probe Failure": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "counters": {
          "total.$": "States.MathAdd($.counters.total, 1)",
          "probeFailures.$": "States.MathAdd($.counters.probeFailures, 1)",
          "stopRefusals.$": "$.counters.stopRefusals",
          "probePoll": 0
        },
        "observed": {},
        "coordination.$": "$.coordination"
      },
      "Next": "Probe Failure Limit Reached"
    },
    "Probe Failure Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.counters.probeFailures",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxConsecutiveProbeFailures",
          "Next": "Watchdog Blind"
        }
      ],
      "Default": "Session Cap Reached"
    },
    "Check Idle Eligibility": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "isIdleStopEligible",
          "serverId.$": "$.request.serverId",
          "sessionId.$": "$.request.sessionId",
          "watchdogExecutionId.$": "$$.Execution.Id",
          "threshold.$": "$.request.timing.emptyChecksRequired"
        }
      },
      "ResultSelector": { "eligible.$": "$.Payload.idleStopEligible" },
      "ResultPath": "$.coordination.idle",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Idle Stop Eligible"
    },
    "Idle Stop Eligible": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.coordination.idle.eligible", "BooleanEquals": true, "Next": "Stop Idle Session" }
      ],
      "Default": "Session Cap Reached"
    },
    "Session Cap Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.counters.total",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxTotalChecks",
          "Next": "Stop Capped Session"
        }
      ],
      "Default": "Wait Between Checks"
    },
    "Stop Idle Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v2_state_machine_arn}",
        "Name.$": "States.Format('{}-idle-{}', $.request.operationId, $.counters.total)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-idle-{}', $.request.operationId, $.counters.total)",
          "sessionId.$": "$.request.sessionId",
          "leaseTtlSeconds.$": "$.request.stopLeaseTtlSeconds",
          "instanceId.$": "$.request.instanceId",
          "worldId.$": "$.request.worldId",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.observed.stop",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.observed.stopError", "Next": "Route Idle Stop Failure" }
      ],
      "Next": "Stopped Idle"
    },
    "Route Idle Stop Failure": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.stopError.Cause",
          "StringMatches": "*Spawnpoint.V2StaleSession*",
          "Next": "Session Superseded"
        },
        {
          "Variable": "$.observed.stopError.Cause",
          "StringMatches": "*Spawnpoint.V2StopRefusedPlayersOnline*",
          "Next": "Count Stop Refusal"
        }
      ],
      "Default": "Watchdog Stop Failing"
    },
    "Count Stop Refusal": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "counters": {
          "total.$": "$.counters.total",
          "probeFailures": 0,
          "stopRefusals.$": "States.MathAdd($.counters.stopRefusals, 1)",
          "probePoll": 0
        },
        "observed": {},
        "coordination.$": "$.coordination"
      },
      "Next": "Stop Refusal Limit Reached"
    },
    "Stop Refusal Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.counters.stopRefusals",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxStopRefusals",
          "Next": "Watchdog Stop Failing"
        }
      ],
      "Default": "Wait Between Checks"
    },
    "Stop Capped Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v2_state_machine_arn}",
        "Name.$": "States.Format('{}-cap-{}', $.request.operationId, $.counters.total)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-cap-{}', $.request.operationId, $.counters.total)",
          "sessionId.$": "$.request.sessionId",
          "leaseTtlSeconds.$": "$.request.stopLeaseTtlSeconds",
          "instanceId.$": "$.request.instanceId",
          "worldId.$": "$.request.worldId",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.observed.stop",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.observed.stopError", "Next": "Route Capped Stop Failure" }
      ],
      "Next": "Stopped At Cap"
    },
    "Route Capped Stop Failure": {
      "Type": "Choice",
      "Comment": "A cap reached while people are playing is not a failure of anything: the stop is refused on purpose, and the session still needs watching. This watchdog has spent its own budget, so it hands the session to a fresh one and ends. Without the hand-over the session ran on unwatched until somebody pressed Stop.",
      "Choices": [
        {
          "Variable": "$.observed.stopError.Cause",
          "StringMatches": "*Spawnpoint.V2StaleSession*",
          "Next": "Session Superseded"
        },
        {
          "Variable": "$.observed.stopError.Cause",
          "StringMatches": "*Spawnpoint.V2StopRefusedPlayersOnline*",
          "Next": "Route Hand Over"
        }
      ],
      "Default": "Watchdog Stop Failing"
    },
    "Route Hand Over": {
      "Type": "Choice",
      "Comment": "A placed session is probed on its own slot, so the relay carries it; an unplaced one has none to carry.",
      "Choices": [
        {
          "Variable": "$.request.slot",
          "IsPresent": true,
          "Next": "Hand Over Placed Session"
        }
      ],
      "Default": "Hand Over Session"
    },
    "Hand Over Placed Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${watchdog_state_machine_arn}",
        "Name.$": "States.Format('{}-relay-{}', $.request.operationId, $.counters.total)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-relay-{}', $.request.operationId, $.counters.total)",
          "sessionId.$": "$.request.sessionId",
          "predecessorExecutionId.$": "$$.Execution.Id",
          "registrationLeaseTtlSeconds.$": "$.request.registrationLeaseTtlSeconds",
          "stopLeaseTtlSeconds.$": "$.request.stopLeaseTtlSeconds",
          "instanceId.$": "$.request.instanceId",
          "slot.$": "$.request.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.timing",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "Watchdog Stop Failing" }
      ],
      "Next": "Handed Over"
    },
    "Hand Over Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${watchdog_state_machine_arn}",
        "Name.$": "States.Format('{}-relay-{}', $.request.operationId, $.counters.total)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-relay-{}', $.request.operationId, $.counters.total)",
          "sessionId.$": "$.request.sessionId",
          "predecessorExecutionId.$": "$$.Execution.Id",
          "registrationLeaseTtlSeconds.$": "$.request.registrationLeaseTtlSeconds",
          "stopLeaseTtlSeconds.$": "$.request.stopLeaseTtlSeconds",
          "instanceId.$": "$.request.instanceId",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.timing",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "Watchdog Stop Failing" }
      ],
      "Next": "Handed Over"
    },
    "Handed Over": {
      "Type": "Pass",
      "End": true
    },
    "Reconcile Externally Stopped Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v2_state_machine_arn}",
        "Name.$": "States.Format('{}-reconcile-stopped', $.request.operationId)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-reconcile-stopped', $.request.operationId)",
          "sessionId.$": "$.request.sessionId",
          "leaseTtlSeconds.$": "$.request.stopLeaseTtlSeconds",
          "instanceId.$": "$.request.instanceId",
          "worldId.$": "$.request.worldId",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.observed.stop",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.observed.stopError", "Next": "Route Reconcile Failure" }
      ],
      "Next": "Host Stopped Externally"
    },
    "Route Reconcile Failure": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.stopError.Cause",
          "StringMatches": "*Spawnpoint.V2StaleSession*",
          "Next": "Session Superseded"
        }
      ],
      "Default": "Watchdog Stop Failing"
    },
    "Session Superseded": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "status": "session_superseded",
        "checksTotal.$": "$.counters.total"
      },
      "End": true
    },
    "Host Stopped Externally": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "status": "host_stopped_externally",
        "checksTotal.$": "$.counters.total"
      },
      "End": true
    },
    "Stopped Idle": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "status": "stopped_idle",
        "checksTotal.$": "$.counters.total"
      },
      "End": true
    },
    "Stopped At Cap": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "status": "stopped_session_cap",
        "checksTotal.$": "$.counters.total"
      },
      "End": true
    },
    "Watchdog Blind": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2WatchdogBlind",
      "Cause": "Consecutive structured probes failed; unknown is never evidence of idle and the exact session remains running."
    },
    "Watchdog Stop Failing": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2WatchdogStopFailing",
      "Cause": "The session-scoped verified stop failed; lifecycle state records whether the host remains ready or stopping."
    }
  }
}
