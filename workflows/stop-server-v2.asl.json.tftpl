{
  "Comment": "Lifecycle V2 stop wrapper: fence the exact session across player recheck, backup verification and EC2 stop.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Initialize",
  "States": {
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "coordination": {}
      },
      "Next": "Read Lifecycle"
    },
    "Read Lifecycle": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "get",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "record.$": "$.Payload.record"
      },
      "ResultPath": "$.coordination.lifecycle",
      "Next": "Route Lifecycle"
    },
    "Route Lifecycle": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.coordination.lifecycle.record.desiredState", "StringEquals": "stopped" },
            { "Variable": "$.coordination.lifecycle.record.observedState", "StringEquals": "stopped" }
          ],
          "Next": "Already Stopped"
        },
        {
          "Variable": "$.coordination.lifecycle.record.activeSessionId",
          "StringEqualsPath": "$.request.sessionId",
          "Next": "Acquire Stop Lease"
        }
      ],
      "Default": "Stale Session"
    },
    "Acquire Stop Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "$.request.operationId",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Begin Stopping Session"
    },
    "Begin Stopping Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Find Placement"
    },
    "Find Placement": {
      "Type": "Task",
      "Comment": "ADR-0054: a stop is told a session and finds its host and slot itself. A session placed nowhere, or a lookup that fails, stops the requested instance as before.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "findPlacement",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placementLookup",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Adopt Requested Host"
        }
      ],
      "Next": "Route Found Placement"
    },
    "Route Found Placement": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.placementLookup.placement",
          "IsNull": true,
          "Next": "Adopt Requested Host"
        }
      ],
      "Default": "Adopt Found Placement"
    },
    "Adopt Found Placement": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.placementLookup.placement.hostId",
        "slot.$": "$.placementLookup.placement.slot"
      },
      "ResultPath": "$.request.placed",
      "Next": "Stop Accepted V1"
    },
    "Adopt Requested Host": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.request.instanceId",
        "slot": ""
      },
      "ResultPath": "$.request.placed",
      "Next": "Stop Accepted V1"
    },
    "Stop Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-host-stop', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.hostStop",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.stopFailure",
          "Next": "Route Stop Failure"
        }
      ],
      "Next": "Mark Session Stopped"
    },
    "Mark Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Placement"
    },
    "Release Placement": {
      "Type": "Task",
      "Comment": "Placement bookkeeping (ADR-0054, phase 5): the session's reservation leaves the host record. Releasing what was never reserved is not a failure, and nothing acts on the drain that follows yet.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releasePlacement",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": {
        "released.$": "$.Payload.released",
        "host.$": "$.Payload.host"
      },
      "ResultPath": "$.placementRelease",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Release Stop Lease"
        }
      ],
      "Next": "Route Emptied Host"
    },
    "Route Emptied Host": {
      "Type": "Choice",
      "Comment": "ADR-0054: the host's half of the two-level stop. A launched host this stop emptied gets a drain; the configured host is stopped by the V1 stop as it always was, and a host that still holds sessions is left alone.",
      "Choices": [
        {
          "Variable": "$.placementRelease.host",
          "IsNull": true,
          "Next": "Release Stop Lease"
        }
      ],
      "Default": "Route Emptied Host State"
    },
    "Route Emptied Host State": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.placementRelease.host.record.state", "StringEquals": "draining" },
            { "Variable": "$.placementRelease.host.record.provenance", "StringEquals": "launched" }
          ],
          "Next": "Start Drain"
        }
      ],
      "Default": "Release Stop Lease"
    },
    "Start Drain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${drain_state_machine_arn}",
        "Name.$": "States.Format('{}-drain', $.request.operationId)",
        "Input": {
          "hostId.$": "$.placementRelease.host.record.hostId",
          "emptiedBy.$": "$.request.sessionId"
        }
      },
      "ResultPath": "$.drain",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.drainStartFailure",
          "Next": "Release Stop Lease"
        }
      ],
      "Next": "Release Stop Lease"
    },
    "Release Stop Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Stopped"
    },
    "Route Stop Failure": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.stopFailure.Cause",
          "StringMatches": "*Spawnpoint.PlayersOnline*",
          "Next": "Cancel Refused Stop"
        }
      ],
      "Default": "Verified Stop Failed"
    },
    "Cancel Refused Stop": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "cancelStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Refused Stop Lease"
    },
    "Release Refused Stop Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Stop Refused Players Online"
    },
    "Stop Refused Players Online": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StopRefusedPlayersOnline",
      "Cause": "A player joined during the final recheck; the exact session returned to ready and its idle streak was reset."
    },
    "Stopped": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "serverId.$": "$.request.serverId",
        "status": "stopped",
        "hostStop.$": "$.hostStop.Output"
      },
      "End": true
    },
    "Already Stopped": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "serverId.$": "$.request.serverId",
        "status": "already_stopped"
      },
      "End": true
    },
    "Stale Session": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StaleSession",
      "Cause": "The stop request does not belong to the active server session."
    },
    "Verified Stop Failed": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2VerifiedStopFailed",
      "Cause": "The exact session remains stopping because player recheck, backup verification or EC2 stop did not complete. Retry after the lease expires."
    }
  }
}
