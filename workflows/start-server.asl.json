{
  "Comment": "Start the Spawnpoint EC2 host and wait until its private Minecraft session is ready.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Report Accepted",
  "States": {
    "Report Accepted": {
      "Type": "Task",
      "Comment": "The run's record: accepted, and running (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": "{% ($f := $merge([{'operation_id': {'S': $states.context.Execution.Name}, 'execution_arn': {'S': $states.context.Execution.Id}, 'type': {'S': 'start'}, 'workflow': {'S': 'start-host'}, 'status': {'S': 'running'}, 'root_id': {'S': ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name)}, 'started_at': {'S': $states.context.Execution.StartTime}, 'updated_at': {'S': $states.context.State.EnteredTime}, 'open_key': {'S': 'open'}, 'expires_at': {'N': $string($floor($toMillis($states.context.Execution.StartTime) / 1000) + 2592000)}, 'step': {'S': 'start.checking_host'}}, $type($states.context.Execution.Input.worldId) = 'string' ? {'world_id': {'S': $states.context.Execution.Input.worldId}} : {}, $type($states.context.Execution.Input.gameId) = 'string' ? {'game_id': {'S': $states.context.Execution.Input.gameId}} : {}, $type($states.context.Execution.Input.serverId) = 'string' ? {'server_id': {'S': $states.context.Execution.Input.serverId}} : {}, $type($states.context.Execution.Input.operationParent) = 'string' ? {'parent_id': {'S': $states.context.Execution.Input.operationParent}} : {}, $type($states.context.Execution.Input.instanceId) = 'string' ? {'host_instance_id': {'S': $states.context.Execution.Input.instanceId}} : {}]); {'TableName': '${operation_table_name}', 'Key': {'pk': {'S': 'OPERATION#' & $states.context.Execution.Name}, 'sk': {'S': 'RECORD'}}, 'UpdateExpression': 'SET ' & $join($map($keys($f), function($k) { '#' & $k & ' = :' & $k }), ', '), 'ExpressionAttributeNames': $merge($map($keys($f), function($k) { {'#' & $k: $k} })), 'ExpressionAttributeValues': $merge($map($keys($f), function($k) { {':' & $k: $lookup($f, $k)} }))}) %}",
      "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" }, "Output": "{% $states.input %}", "Next": "Report Host To Root" }],
      "Next": "Report Host To Root"
    },
    "Report Host To Root": {
      "Type": "Task",
      "Comment": "The outer record names the host, for the log (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #host_instance_id = :host_instance_id, #updated_at = :updated_at REMOVE #command_id",
        "ExpressionAttributeNames": { "#host_instance_id": "host_instance_id", "#updated_at": "updated_at", "#command_id": "command_id" },
        "ExpressionAttributeValues": { ":host_instance_id": { "S": "{% $states.context.Execution.Input.instanceId %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Operation Parent" }],
      "Next": "Route Operation Parent"
    },
    "Route Operation Parent": {
      "Type": "Choice",
      "Comment": "A nested run names itself on its parent's record (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Choices": [{ "Condition": "{% $type($states.context.Execution.Input.operationParent) = 'string' %}", "Next": "Report Child To Parent" }],
      "Default": "Initialize",
      "Output": "{% $states.input %}"
    },
    "Report Child To Parent": {
      "Type": "Task",
      "Comment": "The parent's record names its newest nested run (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Input.operationParent %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #child_id = :child_id, #updated_at = :updated_at",
        "ExpressionAttributeNames": { "#child_id": "child_id", "#updated_at": "updated_at" },
        "ExpressionAttributeValues": { ":child_id": { "S": "{% $states.context.Execution.Name %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Initialize" }],
      "Next": "Initialize"
    },
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "polls": {
          "instance": 0,
          "ssm": 0,
          "command": 0
        },
        "observed": {}
      },
      "Next": "Describe Initial Instance"
    },
    "Describe Initial Instance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultPath": "$.observed.instance",
      "Next": "Route Initial Instance State"
    },
    "Route Initial Instance State": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
          "StringEquals": "running",
          "Next": "Report Wait Before SSM Poll"
        },
        {
          "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
          "StringEquals": "stopped",
          "Next": "Report Start Instance"
        },
        {
          "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
          "StringEquals": "pending",
          "Next": "Report Wait Before Instance Poll"
        }
      ],
      "Default": "Report Instance Cannot Start"
    },
    "Report Start Instance": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.launching_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Instance" }],
      "Next": "Start Instance"
    },
    "Start Instance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:startInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultPath": null,
      "Next": "Report Wait Before Instance Poll"
    },
    "Report Wait Before Instance Poll": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.waiting_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Wait Before Instance Poll" }],
      "Next": "Wait Before Instance Poll"
    },
    "Wait Before Instance Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.timing.instancePollSeconds",
      "Next": "Describe Instance"
    },
    "Describe Instance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultPath": "$.observed.instance",
      "Next": "Instance Running"
    },
    "Instance Running": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
          "StringEquals": "running",
          "Next": "Wait Before SSM Poll"
        },
        {
          "Or": [
            {
              "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
              "StringEquals": "shutting-down"
            },
            {
              "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
              "StringEquals": "terminated"
            }
          ],
          "Next": "Report Instance Cannot Start"
        }
      ],
      "Default": "Increment Instance Poll"
    },
    "Increment Instance Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "polls": {
          "instance.$": "States.MathAdd($.polls.instance, 1)",
          "ssm.$": "$.polls.ssm",
          "command.$": "$.polls.command"
        },
        "observed": {}
      },
      "Next": "Instance Poll Limit Reached"
    },
    "Instance Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.polls.instance",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxInstancePolls",
          "Next": "Report Instance Start Timed Out"
        }
      ],
      "Default": "Wait Before Instance Poll"
    },
    "Report Wait Before SSM Poll": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.waiting_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Wait Before SSM Poll" }],
      "Next": "Wait Before SSM Poll"
    },
    "Wait Before SSM Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.timing.ssmPollSeconds",
      "Next": "Describe SSM Agent"
    },
    "Describe SSM Agent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
      "Parameters": {
        "Filters": [
          {
            "Key": "InstanceIds",
            "Values.$": "States.Array($.request.instanceId)"
          }
        ]
      },
      "ResultPath": "$.observed.ssm",
      "Next": "SSM Record Present"
    },
    "SSM Record Present": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.ssm.InstanceInformationList[0]",
          "IsPresent": true,
          "Next": "SSM Agent Online"
        }
      ],
      "Default": "Increment SSM Poll"
    },
    "SSM Agent Online": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.ssm.InstanceInformationList[0].PingStatus",
          "StringEquals": "Online",
          "Next": "Report Route Session Command"
        }
      ],
      "Default": "Increment SSM Poll"
    },
    "Increment SSM Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "polls": {
          "instance.$": "$.polls.instance",
          "ssm.$": "States.MathAdd($.polls.ssm, 1)",
          "command.$": "$.polls.command"
        },
        "observed": {}
      },
      "Next": "SSM Poll Limit Reached"
    },
    "SSM Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.polls.ssm",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxSsmPolls",
          "Next": "Report SSM Timed Out"
        }
      ],
      "Default": "Wait Before SSM Poll"
    },
    "Report Route Session Command": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.running_command" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Session Command" }],
      "Next": "Route Session Command"
    },
    "Route Session Command": {
      "Type": "Choice",
      "Comment": "A fleet instance may register with SSM before cloud-init finishes. Wait for its explicit bootstrap marker before invoking the game command.",
      "Choices": [
        {
          "And": [
            { "Variable": "$.request.placement", "StringEquals": "fleet" },
            { "Variable": "$.request.slot", "IsPresent": true },
            { "Variable": "$.request.sessionVolumeId", "IsPresent": true },
            { "Not": { "Variable": "$.request.sessionVolumeId", "StringEquals": "" } }
          ],
          "Next": "Start Fleet Session Command On Volume"
        },
        {
          "And": [
            { "Variable": "$.request.placement", "StringEquals": "fleet" },
            { "Variable": "$.request.slot", "IsPresent": true }
          ],
          "Next": "Start Fleet Session Command"
        },
        {
          "Variable": "$.request.slot",
          "IsPresent": true,
          "Next": "Start Placed Session Command"
        }
      ],
      "Default": "Start Session Command"
    },
    "Start Fleet Session Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-start-session",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)",
          "slot.$": "States.Array(States.Format('{}', $.request.slot))",
          "waitForFleet": ["true"]
        },
        "TimeoutSeconds": 900,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultPath": "$.observed.command",
      "Next": "Report Command"
    },
    "Start Fleet Session Command On Volume": {
      "Type": "Task",
      "Comment": "ADR-0102: the session runs its world from the volume Start server V2 attached. The document checks the id's shape before the host reads it.",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-start-session",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)",
          "slot.$": "States.Array(States.Format('{}', $.request.slot))",
          "waitForFleet": ["true"],
          "sessionVolumeId.$": "States.Array($.request.sessionVolumeId)"
        },
        "TimeoutSeconds": 900,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultPath": "$.observed.command",
      "Next": "Report Command"
    },
    "Start Placed Session Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-start-session",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)",
          "slot.$": "States.Array(States.Format('{}', $.request.slot))"
        },
        "TimeoutSeconds": 900,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultPath": "$.observed.command",
      "Next": "Report Command"
    },
    "Start Session Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-start-session",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)"
        },
        "TimeoutSeconds": 900,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultPath": "$.observed.command",
      "Next": "Report Command"
    },
    "Report Command": {
      "Type": "Task",
      "Comment": "The record names the host command, for the log (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #command_id = :command_id, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#command_id": "command_id", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":command_id": { "S": "{% $states.input.observed.command.Command.CommandId %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Report Command To Root" }],
      "Next": "Report Command To Root"
    },
    "Report Command To Root": {
      "Type": "Task",
      "Comment": "The outer record names the host command too: the panel reads the outer one (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #command_id = :command_id, #updated_at = :updated_at",
        "ExpressionAttributeNames": { "#command_id": "command_id", "#updated_at": "updated_at" },
        "ExpressionAttributeValues": { ":command_id": { "S": "{% $states.input.observed.command.Command.CommandId %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Wait Before Command Poll" }],
      "Next": "Wait Before Command Poll"
    },
    "Wait Before Command Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.timing.commandPollSeconds",
      "Next": "Get Session Command"
    },
    "Get Session Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
      "Parameters": {
        "CommandId.$": "$.observed.command.Command.CommandId",
        "InstanceId.$": "$.request.instanceId"
      },
      "ResultPath": "$.observed.invocation",
      "Catch": [
        {
          "ErrorEquals": [
            "Ssm.InvocationDoesNotExistException"
          ],
          "ResultPath": "$.observed.commandLookupError",
          "Next": "Report Caught Before Increment Command Poll"
        }
      ],
      "Next": "Session Command Complete"
    },
    "Session Command Complete": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.invocation.Status",
          "StringEquals": "Success",
          "Next": "Read Session Summary"
        },
        {
          "Or": [
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Pending"
            },
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "InProgress"
            },
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Delayed"
            }
          ],
          "Next": "Increment Command Poll"
        }
      ],
      "Default": "Report Session Start Failed"
    },
    "Report Caught Before Increment Command Poll": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
