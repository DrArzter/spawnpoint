# --- Secrets and local configuration ---
# Nothing secret belongs in this repository. Secrets live in SSM Parameter Store.
.env
.env.*
!.env.example
*.tfvars
!example.tfvars
*.pem
*.key
credentials

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
tfplan
*.tfplan
*.tfplan.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Minecraft data: never in git ---
# The world is state, and mod binaries are large. See ADR-0008 and ADR-0010.
world/
world_*/
mods/
*.jar
*.mrpack
server/data/
server/backups/
server/runtime/
# Release payloads are immutable artefacts in S3 (ADR-0009, ADR-0030), and this
# directory doubles as the host's download cache. The repository tracks the
# contract in server/releases/README.md, never an artefact.
server/releases/*/
logs/
crash-reports/
banned-*.json
ops.json
whitelist.json
usercache.json
server.properties
eula.txt

# --- Build output ---
dist/
build/
out/
*.zip
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# --- Editors and OS ---
.DS_Store
.idea/
.vscode/
*.swp
*~

# Per-root backend configuration names the account's state bucket; the committed shape is backend.hcl.example.
infra/*/backend.hcl
