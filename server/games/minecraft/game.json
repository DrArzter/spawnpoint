{
  "id": "minecraft",
  "code": "MC",
  "display_name": "Minecraft",
  "legacy_default": true,
  "connect": {
    "port": 25565,
    "protocol": "tcp",
    "port_implied": true
  },
  "probe_port": 25575,
  "slottable": true,
  "default_auth": "none",
  "footprint": {
    "memory_mib": 7168,
    "cores": 1
  },
  "capabilities": {
    "whitelist": true
  },
  "console": {
    "lifecycle_commands": [
      "stop",
      "save-off"
    ],
    "suggestions": [
      "list",
      "save-all",
      "say Server stops in 5 minutes"
    ]
  },
  "whitelist": {
    "name_pattern": "^\\w{3,16}$",
    "name_hint": "3 to 16 letters, digits or underscores, as the player types it",
    "list_command": "whitelist list",
    "list_reply": "There are (\\d+) whitelisted player(?:s|\\(s\\))?:\\s*(.*)",
    "list_empty": "There are no whitelisted players"
  },
  "release": {
    "version_field": "minecraft_version",
    "loader_type": "minecraft",
    "loader_versioned": true,
    "mod_extension": "jar",
    "resolver": "curseforge-files",
    "runtime_image_required": false,
    "loader_types": [
      "vanilla",
      "forge",
      "neoforge",
      "fabric",
      "quilt"
    ],
    "default_loader_type": "forge",
    "bare_loader_types": [
      "vanilla"
    ],
    "resolvers": [
      "curseforge-files",
      "curseforge-modpack"
    ],
    "side_lists": true,
    "addons": true,
    "requires_curseforge_key": true
  }
}
