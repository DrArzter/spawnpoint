{
  "name": "@spawnpoint/lambdas",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "esbuild src/bot/handler.ts --bundle --platform=node --format=esm --target=node22 --external:@aws-sdk/* --outfile=dist/bot/index.mjs && esbuild src/bot/notifier.ts --bundle --platform=node --format=esm --target=node22 --external:@aws-sdk/* --outfile=dist/notifier/index.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sfn": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "grammy": "^1.45.1"
  }
}
