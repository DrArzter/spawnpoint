{
  "Comment": "Publish an immutable release from a pack an operator uploaded. The archive is validated inside the reviewed builder, never here.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Validate Request Shape",
  "States": {
    "Validate Request Shape": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.uploadKey",
              "IsPresent": true
            },
            {
              "Variable": "$.uploadKey",
              "IsString": true
            },
            {
              "Variable": "$.release",
              "IsPresent": true
            },
            {
              "Variable": "$.release",
              "IsString": true
            },
            {
              "Variable": "$.game",
              "IsPresent": true
            },
            {
              "Variable": "$.game",
              "IsString": true
            },
            {
              "Variable": "$.gameVersion",
              "IsPresent": true
            },
            {
              "Variable": "$.gameVersion",
              "IsString": true
            },
            {
              "Variable": "$.loaderVersion",
              "IsPresent": true
            },
            {
              "Variable": "$.loaderVersion",
              "IsString": true
            }
          ],
          "Next": "Publish Uploaded Pack"
        }
      ],
      "Default": "Invalid Publish Request"
    },
    "Publish Uploaded Pack": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "UPLOAD_KEY",
            "Type": "PLAINTEXT",
            "Value.$": "$.uploadKey"
          },
          {
            "Name": "RELEASE",
            "Type": "PLAINTEXT",
            "Value.$": "$.release"
          },
          {
            "Name": "RELEASE_GAME",
            "Type": "PLAINTEXT",
            "Value.$": "$.game"
          },
          {
            "Name": "GAME_VERSION",
            "Type": "PLAINTEXT",
            "Value.$": "$.gameVersion"
          },
          {
            "Name": "LOADER_VERSION",
            "Type": "PLAINTEXT",
            "Value.$": "$.loaderVersion"
          },
          {
            "Name": "RELEASE_CREATED_BY",
            "Type": "PLAINTEXT",
            "Value.$": "$.requestedBy"
          }
        ]
      },
      "ResultPath": null,
      "TimeoutSeconds": 2100,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.buildFailure",
          "Next": "Publish Failed"
        }
      ],
      "Next": "Release Ready"
    },
    "Release Ready": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.operationId",
        "status": "READY",
        "release.$": "$.release",
        "manifestKey.$": "States.Format('releases/{}/manifest.json', $.release)"
      },
      "End": true
    },
    "Invalid Publish Request": {
      "Type": "Fail",
      "Error": "Spawnpoint.InvalidPublishRequest",
      "Cause": "A publish request must name the upload key, the release, the game and both versions."
    },
    "Publish Failed": {
      "Type": "Fail",
      "Error": "Spawnpoint.PackPublishFailed",
      "Cause": "The builder refused the uploaded pack or could not publish it. Nothing is deployed: publishing writes a release, never a pointer."
    }
  }
}
