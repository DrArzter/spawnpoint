        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.observed.commandLookupError.Error) = 'string' ? $substring($states.input.observed.commandLookupError.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.observed.commandLookupError.Cause) = 'string' ? $substring($states.input.observed.commandLookupError.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.running_command" }, ":step": { "S": "start.running_command" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
