{
  "Comment": "Lifecycle V2 start wrapper: fence one session, delegate host work to accepted V1, and compensate a failed start.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Report Accepted",
  "States": {
    "Report Accepted": {
      "Type": "Task",
      "Comment": "The run's record: accepted, and running (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": "{% ($f := $merge([{'operation_id': {'S': $states.context.Execution.Name}, 'execution_arn': {'S': $states.context.Execution.Id}, 'type': {'S': 'start'}, 'workflow': {'S': 'start'}, 'status': {'S': 'running'}, 'root_id': {'S': ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name)}, 'started_at': {'S': $states.context.Execution.StartTime}, 'updated_at': {'S': $states.context.State.EnteredTime}, 'open_key': {'S': 'open'}, 'expires_at': {'N': $string($floor($toMillis($states.context.Execution.StartTime) / 1000) + 2592000)}, 'step': {'S': 'start.preparing'}}, $type($states.context.Execution.Input.worldId) = 'string' ? {'world_id': {'S': $states.context.Execution.Input.worldId}} : {}, $type($states.context.Execution.Input.gameId) = 'string' ? {'game_id': {'S': $states.context.Execution.Input.gameId}} : {}, $type($states.context.Execution.Input.serverId) = 'string' ? {'server_id': {'S': $states.context.Execution.Input.serverId}} : {}, $type($states.context.Execution.Input.operationParent) = 'string' ? {'parent_id': {'S': $states.context.Execution.Input.operationParent}} : {}]); {'TableName': '${operation_table_name}', 'Key': {'pk': {'S': 'OPERATION#' & $states.context.Execution.Name}, 'sk': {'S': 'RECORD'}}, 'UpdateExpression': 'SET ' & $join($map($keys($f), function($k) { '#' & $k & ' = :' & $k }), ', '), 'ExpressionAttributeNames': $merge($map($keys($f), function($k) { {'#' & $k: $k} })), 'ExpressionAttributeValues': $merge($map($keys($f), function($k) { {':' & $k: $lookup($f, $k)} }))}) %}",
      "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" }, "Output": "{% $states.input %}", "Next": "Route Operation Parent" }],
      "Next": "Route Operation Parent"
    },
    "Route Operation Parent": {
      "Type": "Choice",
      "Comment": "A nested run names itself on its parent's record (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Choices": [{ "Condition": "{% $type($states.context.Execution.Input.operationParent) = 'string' %}", "Next": "Report Child To Parent" }],
      "Default": "Initialize",
      "Output": "{% $states.input %}"
    },
    "Report Child To Parent": {
      "Type": "Task",
      "Comment": "The parent's record names its newest nested run (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Input.operationParent %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #child_id = :child_id, #updated_at = :updated_at",
        "ExpressionAttributeNames": { "#child_id": "child_id", "#updated_at": "updated_at" },
        "ExpressionAttributeValues": { ":child_id": { "S": "{% $states.context.Execution.Name %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Initialize" }],
      "Next": "Initialize"
    },
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "defaults": {
          "gameId.$": "$.serverId",
          "worldName": "",
          "placement": "single",
          "launch": "disabled",
          "appCommit": "main",
          "policy": "cold",
          "market": "spot",
          "footprint": null,
          "move": false,
          "moveVolumeId": ""
        },
        "coordination": {
          "forcedStopPolls": 0
        },
        "sessionVolume": {
          "mode": "${session_volume}",
          "volumeId": "",
          "createPolls": { "count": 0 },
          "attachPolls": { "count": 0 },
          "unmountPolls": { "count": 0 },
          "detachPolls": { "count": 0 }
        },
        "spot": {
          "mode": "${spot}"
        }
      },
      "Next": "Apply Request Defaults"
    },
    "Apply Request Defaults": {
      "Type": "Pass",
      "Comment": "What a caller leaves out. ADR-0062: serverId is the lifecycle record's key, a fleet world's own or its game's; a caller that predates the split sends no gameId, and its serverId is the game. A CLI promotion's nested starts name no placement, and the configured host is the only one they can mean; a fleet world's promotion names `fleet` (ADR-0078). A caller that names no policy places the session cold (ADR-0048).",
      "Parameters": {
        "request.$": "States.JsonMerge($.defaults, $.request, false)",
        "coordination.$": "$.coordination",
        "sessionVolume.$": "$.sessionVolume",
        "spot.$": "$.spot"
      },
      "Next": "Initialize Lifecycle"
    },
    "Initialize Lifecycle": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "initialize",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Acquire Start Lease"
    },
    "Acquire Start Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "$.request.operationId",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Begin Session"
    },
    "Begin Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginSession",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Report Route Placement Mode"
    },
    "Report Route Placement Mode": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.choosing_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Placement Mode" }],
      "Next": "Route Placement Mode"
    },
    "Route Placement Mode": {
      "Type": "Choice",
      "Comment": "ADR-0054. `single` starts the configured instance. `shared` registers it before placement. `fleet` excludes it and reuses or launches only ephemeral hosts, so portable worlds scale to zero.",
      "Choices": [
        {
          "Variable": "$.request.placement",
          "StringEquals": "fleet",
          "Next": "Place Fleet Session"
        },
        {
          "Variable": "$.request.placement",
          "StringEquals": "shared",
          "Next": "Describe Configured Host"
        }
      ],
      "Default": "Adopt Configured Host"
    },
    "Adopt Configured Host": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.request.instanceId",
        "slot": ""
      },
      "ResultPath": "$.request.placed",
      "Next": "Report Start Accepted V1"
    },
    "Place Fleet Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "placeSession",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "gameId.$": "$.request.gameId",
          "policy.$": "$.request.policy",
          "market.$": "$.request.market",
          "footprint.$": "$.request.footprint",
          "eligibleProvenance": "launched"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Placement Unavailable"
        }
      ],
      "Next": "Route Placement"
    },
    "Describe Configured Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultSelector": {
        "instanceType.$": "$.Reservations[0].Instances[0].InstanceType"
      },
      "ResultPath": "$.host",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Placement Unavailable"
        }
      ],
      "Next": "Describe Configured Host Shape"
    },
    "Describe Configured Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.host.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.host.shape",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Placement Unavailable"
        }
      ],
      "Next": "Register Configured Host"
    },
    "Register Configured Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.request.instanceId",
          "ready": true,
          "shape": {
            "instanceType.$": "$.host.instanceType",
            "memoryMiB.$": "$.host.shape.memoryMiB",
            "vcpu.$": "$.host.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Placement Unavailable"
        }
      ],
      "Next": "Place Session"
    },
    "Place Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "placeSession",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "gameId.$": "$.request.gameId",
          "policy.$": "$.request.policy",
          "market.$": "$.request.market",
          "footprint.$": "$.request.footprint"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Placement Unavailable"
        }
      ],
      "Next": "Route Placement"
    },
    "Route Placement": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.placement.placement.kind",
          "StringEquals": "reuse",
          "Next": "Adopt Placement"
        },
        {
          "And": [
            { "Variable": "$.placement.placement.kind", "StringEquals": "launch" },
            { "Variable": "$.request.launch", "StringEquals": "enabled" }
          ],
          "Next": "Report Route Launch Market"
        }
      ],
      "Default": "Report No Host Has Room"
    },
    "Report Route Launch Market": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.launching_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Launch Market" }],
      "Next": "Route Launch Market"
    },
    "Route Launch Market": {
      "Type": "Choice",
      "Comment": "ADR-0102, step 3: a host whose session may lose it (cold, of a game that declares spot) is asked for on Spot, but only with the session volume on, because a Spot host without one has no local copy to save to. Off, or any other session, launches on demand exactly as before.",
      "Choices": [
        {
          "And": [
            { "Variable": "$.spot.mode", "StringEquals": "enabled" },
            { "Variable": "$.sessionVolume.mode", "StringEquals": "enabled" },
            { "Variable": "$.request.policy", "StringEquals": "cold" },
            { "Variable": "$.placement.placement.spot", "BooleanEquals": true }
          ],
          "Next": "Launch Spot Host"
        }
      ],
      "Default": "Launch Host"
    },
    "Launch Spot Host": {
      "Type": "Task",
      "Comment": "ADR-0102: the on-demand request with Spot as the target, price-capacity-optimized and no maximum price. An instant Fleet that finds no capacity answers with errors and no instance rather than failing.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createFleet",
      "Parameters": {
        "Type": "instant",
        "LaunchTemplateConfigs": [
          {
            "LaunchTemplateSpecification": {
              "LaunchTemplateName": "${fleet_launch_template_name}",
              "Version": "$Latest"
            },
            "Overrides": [
              {
                "InstanceRequirements": {
                  "MemoryMiB": { "Min.$": "$.placement.placement.requirements.memoryMiB" },
                  "VCpuCount": { "Min.$": "$.placement.placement.requirements.vcpu" },
                  "AllowedInstanceTypes": ${allowed_instance_types},
                  "BurstablePerformance": "excluded"
                }
              }
            ]
          }
        ],
        "TargetCapacitySpecification": {
          "TotalTargetCapacity": 1,
          "DefaultTargetCapacityType": "spot"
        },
        "SpotOptions": {
          "AllocationStrategy": "price-capacity-optimized"
        },
        "TagSpecifications": [
          {
            "ResourceType": "instance",
            "Tags": [
              { "Key": "AppCommit", "Value.$": "$.request.appCommit" },
              { "Key": "LaunchedFor", "Value.$": "$.request.sessionId" }
            ]
          }
        ]
      },
      "ResultPath": "$.spotLaunch",
      "Catch": [
        {
          "ErrorEquals": [
            "Ec2.InsufficientInstanceCapacityException",
            "Ec2.InsufficientInstanceCapacity",
            "Ec2.UnfulfillableCapacityException",
            "Ec2.UnfulfillableCapacity"
          ],
          "ResultPath": "$.spotFailure",
          "Next": "Report Caught Before Launch Host"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Placement Unavailable"
        }
      ],
      "Next": "Route Spot Answer"
    },
    "Route Spot Answer": {
      "Type": "Choice",
      "Comment": "An instance means Spot answered. No instance for want of capacity falls back to on demand, which ADR-0102 accepts knowingly: one instance an evening, against no server that evening. Any other refusal fails the placement.",
      "Choices": [
        {
          "Variable": "$.spotLaunch.Instances[0].InstanceIds[0]",
          "IsPresent": true,
          "Next": "Adopt Spot Host"
        },
        {
          "Variable": "$.spotLaunch.Errors[0].ErrorCode",
          "IsPresent": false,
          "Next": "Spot Launch Refused"
        },
        {
          "Or": [
            { "Variable": "$.spotLaunch.Errors[0].ErrorCode", "StringEquals": "InsufficientInstanceCapacity" },
            { "Variable": "$.spotLaunch.Errors[0].ErrorCode", "StringEquals": "UnfulfillableCapacity" },
            { "Variable": "$.spotLaunch.Errors[0].ErrorCode", "StringEquals": "InsufficientCapacity" }
          ],
          "Next": "Launch Host"
        }
      ],
      "Default": "Spot Launch Refused"
    },
    "Spot Launch Refused": {
      "Type": "Pass",
      "Parameters": {
        "Error": "SpotLaunchRefused",
        "Cause.$": "States.JsonToString($.spotLaunch)"
      },
      "ResultPath": "$.placementFailure",
      "Next": "Report Placement Unavailable"
    },
    "Adopt Spot Host": {
      "Type": "Pass",
      "Parameters": {
        "instanceId.$": "$.spotLaunch.Instances[0].InstanceIds[0]",
        "instanceType.$": "$.spotLaunch.Instances[0].InstanceType",
        "market": "spot"
      },
      "ResultPath": "$.launched",
      "Next": "Describe Launched Host Shape"
    },
    "Report Caught Before Launch Host": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.spotFailure.Error) = 'string' ? $substring($states.input.spotFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.spotFailure.Cause) = 'string' ? $substring($states.input.spotFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.launching_host" }, ":step": { "S": "start.launching_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Launch Host" }],
      "Next": "Launch Host"
    },
    "Launch Host": {
      "Type": "Task",
      "Comment": "ADR-0054, phase 12: an instant Fleet for exactly what the footprint needs. EC2 answers with the cheapest type in the allowed families; no type and no price lives here.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createFleet",
      "Parameters": {
        "Type": "instant",
        "LaunchTemplateConfigs": [
          {
            "LaunchTemplateSpecification": {
              "LaunchTemplateName": "${fleet_launch_template_name}",
              "Version": "$Latest"
            },
            "Overrides": [
              {
                "InstanceRequirements": {
                  "MemoryMiB": { "Min.$": "$.placement.placement.requirements.memoryMiB" },
                  "VCpuCount": { "Min.$": "$.placement.placement.requirements.vcpu" },
                  "AllowedInstanceTypes": ${allowed_instance_types},
                  "BurstablePerformance": "excluded"
                }
              }
            ]
          }
        ],
        "TargetCapacitySpecification": {
          "TotalTargetCapacity": 1,
          "DefaultTargetCapacityType": "on-demand"
        },
        "OnDemandOptions": {
          "AllocationStrategy": "lowest-price",
          "SingleInstanceType": true
        },
        "TagSpecifications": [
          {
            "ResourceType": "instance",
            "Tags": [
              { "Key": "AppCommit", "Value.$": "$.request.appCommit" },
              { "Key": "LaunchedFor", "Value.$": "$.request.sessionId" }
            ]
          }
        ]
      },
      "ResultSelector": {
        "instanceId.$": "$.Instances[0].InstanceIds[0]",
        "instanceType.$": "$.Instances[0].InstanceType",
        "market": "on-demand"
      },
      "ResultPath": "$.launched",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Placement Unavailable"
        }
      ],
      "Next": "Describe Launched Host Shape"
    },
    "Describe Launched Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.launched.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.launched.shape",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Terminate Unreserved Host"
        }
      ],
      "Next": "Register Launched Host"
    },
    "Register Launched Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.launched.instanceId",
          "ready": true,
          "provenance": "launched",
          "market.$": "$.launched.market",
          "shape": {
            "instanceType.$": "$.launched.instanceType",
            "memoryMiB.$": "$.launched.shape.memoryMiB",
            "vcpu.$": "$.launched.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Terminate Unreserved Host"
        }
      ],
      "Next": "Reserve On Launched Host"
    },
    "Reserve On Launched Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "reserveOnHost",
          "hostId.$": "$.launched.instanceId",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "gameId.$": "$.request.gameId",
          "policy.$": "$.request.policy",
          "market.$": "$.request.market",
          "footprint.$": "$.request.footprint"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Terminate Unreserved Host"
        }
      ],
      "Next": "Report Adopt Placement"
    },
    "Report Caught Before Terminate Unreserved Host": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.placementFailure.Error) = 'string' ? $substring($states.input.placementFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.placementFailure.Cause) = 'string' ? $substring($states.input.placementFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.cancelling" }, ":step": { "S": "start.cancelling" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Terminate Unreserved Host" }],
      "Next": "Terminate Unreserved Host"
    },
    "Terminate Unreserved Host": {
      "Type": "Task",
      "Comment": "A host launched for this session that could not be recorded or reserved is let go at once, before it can be billed for an evening nobody knows about.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:terminateInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.launched.instanceId)"
      },
      "ResultPath": "$.unreservedTermination",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.unreservedTerminationFailure",
          "Next": "Report Caught Before Placement Unavailable 2"
        }
      ],
      "Next": "Placement Unavailable"
    },
    "Report Adopt Placement": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.choosing_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Adopt Placement" }],
      "Next": "Adopt Placement"
    },
    "Adopt Placement": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.placement.placement.hostId",
        "slot.$": "$.placement.placement.slot"
      },
      "ResultPath": "$.request.placed",
      "Next": "Report Route Session Volume"
    },
    "Report Route Session Volume": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.starting_server" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Session Volume" }],
      "Next": "Route Session Volume"
    },
    "Route Session Volume": {
      "Type": "Choice",
      "Comment": "ADR-0102, step 2: a cold session on a launched host runs its world from its own volume, created in the host's zone. Off, or any other session, starts as before.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.sessionVolume.mode",
              "StringEquals": "enabled"
            },
            {
              "Variable": "$.request.placement",
              "StringEquals": "fleet"
            },
            {
              "Variable": "$.request.policy",
              "StringEquals": "cold"
            }
          ],
          "Next": "Describe Session Host Zone"
        }
      ],
      "Default": "Start Accepted V1"
    },
    "Describe Session Host Zone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultSelector": {
        "zone.$": "$.Reservations[0].Instances[0].Placement.AvailabilityZone"
      },
      "ResultPath": "$.sessionVolume.host",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.startFailure",
          "Next": "Report Caught Before Begin Compensating Stop"
        }
      ],
      "Next": "Route Moved Session Volume"
    },
    "Route Moved Session Volume": {
      "Type": "Choice",
      "Comment": "ADR-0102, step 5: a session moving off a reclaimed Spot host brings its volume, which holds the world it saved there. A move without one restores from S3 onto a new volume, as any start does.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.request.move",
              "BooleanEquals": true
            },
            {
              "Not": {
                "Variable": "$.request.moveVolumeId",
                "StringEquals": ""
              }
            }
          ],
          "Next": "Adopt Moved Session Volume"
        }
      ],
      "Default": "Create Session Volume"
    },
    "Adopt Moved Session Volume": {
      "Type": "Pass",
      "Parameters": {
        "volumeId.$": "$.request.moveVolumeId"
      },
      "ResultPath": "$.sessionVolume.created",
      "Next": "Describe Created Session Volume"
    },
    "Create Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createVolume",
      "Comment": "Tagged at creation, so the IAM tag condition and the sweeper see it from its first second.",
      "Parameters": {
        "AvailabilityZone.$": "$.sessionVolume.host.zone",
        "Size.$": "States.StringToJson('${session_volume_size_gib}')",
        "VolumeType": "gp3",
        "Encrypted": true,
        "TagSpecifications": [
          {
            "ResourceType": "volume",
            "Tags": [
              {
                "Key": "ManagedBy",
                "Value": "${session_volume_managed_by}"
              },
              {
                "Key": "${session_volume_session_tag}",
                "Value.$": "$.request.sessionId"
              },
              {
                "Key": "WorldId",
                "Value.$": "$.request.worldId"
              }
            ]
          }
        ]
      },
      "ResultSelector": {
        "volumeId.$": "$.VolumeId"
      },
      "ResultPath": "$.sessionVolume.created",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.startFailure",
          "Next": "Report Caught Before Begin Compensating Stop"
        }
      ],
      "Next": "Wait Before Created Volume Poll"
    },
    "Wait Before Created Volume Poll": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Describe Created Session Volume"
    },
    "Describe Created Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
      "Parameters": {
        "VolumeIds.$": "States.Array($.sessionVolume.created.volumeId)"
      },
      "ResultSelector": {
        "state.$": "$.Volumes[0].State",
        "zone.$": "$.Volumes[0].AvailabilityZone"
      },
      "ResultPath": "$.sessionVolume.observed",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.startFailure",
          "Next": "Report Caught Before Begin Compensating Stop"
        }
      ],
      "Next": "Session Volume Available"
    },
    "Session Volume Available": {
      "Type": "Choice",
      "Comment": "A moved volume must be in the new host's zone; every launched host shares one subnet, so this guards a change to that. It is still in use while the reclaimed host lets it go.",
      "Choices": [
        {
          "Not": {
            "Variable": "$.sessionVolume.observed.zone",
            "StringEqualsPath": "$.sessionVolume.host.zone"
          },
          "Next": "Session Volume Unavailable"
        },
        {
          "Variable": "$.sessionVolume.observed.state",
          "StringEquals": "available",
          "Next": "Attach Session Volume"
        },
        {
          "And": [
            {
              "Variable": "$.request.move",
              "BooleanEquals": true
            },
            {
              "Variable": "$.sessionVolume.observed.state",
              "StringEquals": "in-use"
            }
          ],
          "Next": "Count Created Volume Poll"
        },
        {
          "Variable": "$.sessionVolume.observed.state",
          "StringEquals": "creating",
          "Next": "Count Created Volume Poll"
        }
      ],
      "Default": "Session Volume Unavailable"
    },
    "Count Created Volume Poll": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.sessionVolume.createPolls.count, 1)"
      },
      "ResultPath": "$.sessionVolume.createPolls",
      "Next": "Created Volume Poll Limit Reached"
    },
    "Created Volume Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.createPolls.count",
          "NumericGreaterThanEquals": 30,
          "Next": "Session Volume Unavailable"
        }
      ],
      "Default": "Wait Before Created Volume Poll"
    },
    "Attach Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:attachVolume",
      "Comment": "The device name comes from the session's slot, so two sessions on one host never ask for the same one. The host finds the volume by its id, not by this name. A host launched a second ago is still pending and EC2 refuses the attach (IncorrectInstanceState); a move reaches this at once, with no volume to create first, so the attach is retried for up to a minute.",
      "Parameters": {
        "Device.$": "States.ArrayGetItem(States.Array('/dev/sdf', '/dev/sdg', '/dev/sdh', '/dev/sdi', '/dev/sdj', '/dev/sdk', '/dev/sdl', '/dev/sdm', '/dev/sdn', '/dev/sdo', '/dev/sdp', '/dev/sdq', '/dev/sdr', '/dev/sds', '/dev/sdt', '/dev/sdu', '/dev/sdv', '/dev/sdw', '/dev/sdx', '/dev/sdy', '/dev/sdz'), $.request.placed.slot)",
        "InstanceId.$": "$.request.placed.hostId",
        "VolumeId.$": "$.sessionVolume.created.volumeId"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": ["Ec2.Ec2Exception"],
          "IntervalSeconds": 6,
          "MaxAttempts": 10,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.startFailure",
          "Next": "Report Caught Before Begin Compensating Stop"
        }
      ],
      "Next": "Wait Before Attached Volume Poll"
    },
    "Wait Before Attached Volume Poll": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Describe Attached Session Volume"
    },
    "Describe Attached Session Volume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
      "Parameters": {
        "VolumeIds.$": "States.Array($.sessionVolume.created.volumeId)"
      },
      "ResultSelector": {
        "attachments.$": "$.Volumes[0].Attachments"
      },
      "ResultPath": "$.sessionVolume.observed",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.startFailure",
          "Next": "Report Caught Before Begin Compensating Stop"
        }
      ],
      "Next": "Session Volume Attached"
    },
    "Session Volume Attached": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.sessionVolume.observed.attachments[0].State",
              "IsPresent": true
            },
            {
              "Variable": "$.sessionVolume.observed.attachments[0].State",
              "StringEquals": "attached"
            }
          ],
          "Next": "Adopt Session Volume"
        }
      ],
      "Default": "Count Attached Volume Poll"
    },
    "Count Attached Volume Poll": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.sessionVolume.attachPolls.count, 1)"
      },
      "ResultPath": "$.sessionVolume.attachPolls",
      "Next": "Attached Volume Poll Limit Reached"
    },
    "Attached Volume Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.attachPolls.count",
          "NumericGreaterThanEquals": 30,
          "Next": "Session Volume Unavailable"
        }
      ],
      "Default": "Wait Before Attached Volume Poll"
    },
    "Adopt Session Volume": {
      "Type": "Pass",
      "InputPath": "$.sessionVolume.created.volumeId",
      "ResultPath": "$.sessionVolume.volumeId",
      "Next": "Start Accepted V1"
    },
    "Session Volume Unavailable": {
      "Type": "Pass",
      "Comment": "The volume did not become available or attached in time. The start is compensated like a failed host start; the release after the verified stop, or the sweeper, deletes the volume.",
      "Result": {
        "Error": "Spawnpoint.SessionVolumeUnavailable",
        "Cause": "The session volume did not become available and attached before the poll limit."
      },
      "ResultPath": "$.startFailure",
      "Next": "Report Begin Compensating Stop"
    },
    "Report No Host Has Room": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.cancelling" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "No Host Has Room" }],
      "Next": "No Host Has Room"
    },
    "No Host Has Room": {
      "Type": "Pass",
      "Comment": "The coordinator answered with what to launch and launching is disabled, or the world is bound to the configured host and that host has no room (ADR-0054). The session is cancelled cleanly rather than started on a host that has no room for it.",
      "Result": { "reason": "no_host_has_room" },
      "ResultPath": "$.placementRefusal",
      "Next": "Begin Cancelling Unplaced Session"
    },
    "Report Caught Before Placement Unavailable": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.placementFailure.Error) = 'string' ? $substring($states.input.placementFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.placementFailure.Cause) = 'string' ? $substring($states.input.placementFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.cancelling" }, ":step": { "S": "start.cancelling" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Placement Unavailable" }],
      "Next": "Placement Unavailable"
    },
    "Report Placement Unavailable": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.cancelling" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Placement Unavailable" }],
      "Next": "Placement Unavailable"
    },
    "Report Caught Before Placement Unavailable 2": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.unreservedTerminationFailure.Error) = 'string' ? $substring($states.input.unreservedTerminationFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.unreservedTerminationFailure.Cause) = 'string' ? $substring($states.input.unreservedTerminationFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.cancelling" }, ":step": { "S": "start.cancelling" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Placement Unavailable" }],
      "Next": "Placement Unavailable"
    },
    "Placement Unavailable": {
      "Type": "Pass",
      "Result": { "reason": "placement_unavailable" },
      "ResultPath": "$.placementRefusal",
      "Next": "Begin Cancelling Unplaced Session"
    },
    "Begin Cancelling Unplaced Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Mark Unplaced Session Stopped"
    },
    "Mark Unplaced Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Release Unplaced Lease"
    },
    "Release Unplaced Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Report Start Refused Unplaced"
    },
    "Report Start Refused Unplaced": {
      "Type": "Task",
      "Comment": "The record ends as failed (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #error = :error, #cause = :cause, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#error": "error", "#cause": "cause", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "failed" }, ":error": { "S": "Spawnpoint.SessionUnplaced" }, ":cause": { "S": "No registered host has room for this session and launching one is disabled or failed, or the world is bound to the configured host, or the placement could not be read. Nothing was started; the session was cancelled and its lease released." }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Refused Unplaced" }],
      "Next": "Start Refused Unplaced"
    },
    "Start Refused Unplaced": {
      "Type": "Fail",
      "Error": "Spawnpoint.SessionUnplaced",
      "Cause": "No registered host has room for this session and launching one is disabled or failed, or the world is bound to the configured host, or the placement could not be read. Nothing was started; the session was cancelled and its lease released."
    },
    "Report Start Accepted V1": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.starting_server" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Accepted V1" }],
      "Next": "Start Accepted V1"
    },
    "Start Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${start_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-host-start', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "placement.$": "$.request.placement",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "sessionVolumeId.$": "$.sessionVolume.volumeId",
          "timing.$": "$.request.startTiming",
          "operationParent.$": "$$.Execution.Name",
          "operationRoot.$": "$operationRoot"
        }
      },
      "ResultPath": "$.hostStart",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.startFailure",
          "Next": "Report Caught Before Begin Compensating Stop"
        }
      ],
      "Next": "Report Route Bookkeeping"
    },
    "Report Route Bookkeeping": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Bookkeeping" }],
      "Next": "Route Bookkeeping"
    },
    "Route Bookkeeping": {
      "Type": "Choice",
      "Comment": "Shared and Fleet sessions already reserved their actual host. Only single mode records the configured host and slot zero after the fact.",
      "Choices": [
        {
          "Variable": "$.request.placement",
          "StringEquals": "shared",
          "Next": "Mark Session Ready"
        },
        {
          "Variable": "$.request.placement",
          "StringEquals": "fleet",
          "Next": "Mark Session Ready"
        }
      ],
      "Default": "Describe Host"
    },
    "Describe Host": {
      "Type": "Task",
      "Comment": "Single-mode bookkeeping: record the configured host and slot zero. A Fleet session must never reserve this unrelated instance.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultSelector": {
        "instanceType.$": "$.Reservations[0].Instances[0].InstanceType"
      },
      "ResultPath": "$.host",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Mark Session Ready"
        }
      ],
      "Next": "Describe Host Shape"
    },
    "Describe Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.host.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.host.shape",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Mark Session Ready"
        }
      ],
      "Next": "Register Host"
    },
    "Register Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.request.instanceId",
          "ready": true,
          "shape": {
            "instanceType.$": "$.host.instanceType",
            "memoryMiB.$": "$.host.shape.memoryMiB",
            "vcpu.$": "$.host.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Mark Session Ready"
        }
      ],
      "Next": "Reserve Slot Zero"
    },
    "Reserve Slot Zero": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "reserveOnHost",
          "hostId.$": "$.request.instanceId",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "gameId.$": "$.request.gameId",
          "policy.$": "$.request.policy",
          "market.$": "$.request.market",
          "footprint.$": "$.request.footprint"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Report Caught Before Mark Session Ready"
        }
      ],
      "Next": "Mark Session Ready"
    },
    "Report Caught Before Mark Session Ready": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.placementFailure.Error) = 'string' ? $substring($states.input.placementFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.placementFailure.Cause) = 'string' ? $substring($states.input.placementFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.recording" }, ":step": { "S": "start.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Mark Session Ready" }],
      "Next": "Mark Session Ready"
    },
    "Mark Session Ready": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markSessionReady",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId",
          "connectionAddress.$": "$.hostStart.Output.connectionAddress"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Record Session Host"
    },
    "Record Session Host": {
      "Type": "Task",
      "Comment": "Which host this session ran on, for the metrics history (ADR-0015). Best effort: a session that cannot be recorded still runs.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "openSessionHistory",
          "worldId.$": "$.request.worldId",
          "sessionId.$": "$.request.sessionId",
          "hostId.$": "$.request.placed.hostId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.sessionHistoryFailure",
          "Next": "Report Caught Before Route Release Commit"
        }
      ],
      "Next": "Route Release Commit"
    },
    "Report Caught Before Route Release Commit": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionHistoryFailure.Error) = 'string' ? $substring($states.input.sessionHistoryFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionHistoryFailure.Cause) = 'string' ? $substring($states.input.sessionHistoryFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.recording" }, ":step": { "S": "start.recording" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Release Commit" }],
      "Next": "Route Release Commit"
    },
    "Route Release Commit": {
      "Type": "Choice",
      "Comment": "A start that reached ready is the evidence the active release is defined by. Only promotion used to record it, so a world created from a preset and simply started stayed 'ready for first start' for ever. A host on the legacy layout reports no generation, and there is then nothing to record against.",
      "Choices": [
        {
          "And": [
            { "Variable": "$.hostStart.Output.generationId", "IsPresent": true },
            { "Variable": "$.hostStart.Output.generationId", "IsNull": false },
            { "Variable": "$.hostStart.Output.desiredRelease", "IsPresent": true },
            { "Variable": "$.hostStart.Output.desiredRelease", "IsNull": false }
          ],
          "Next": "Commit Active Release"
        }
      ],
      "Default": "Release Start Lease"
    },
    "Commit Active Release": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${release_state_function_arn}",
        "Payload": {
          "action": "commit",
          "worldId.$": "$.request.worldId",
          "generationId.$": "$.hostStart.Output.generationId",
          "release.$": "$.hostStart.Output.desiredRelease",
          "operationId.$": "$.request.operationId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Comment": "The session is ready whatever the pointer says. Bookkeeping that fails leaves the previous active release standing and must not undo a start.",
          "ResultPath": null,
          "Next": "Release Start Lease"
        }
      ],
      "Next": "Release Start Lease"
    },
    "Release Start Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Report Start Session Watchdog"
    },
    "Report Start Session Watchdog": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.starting_watchdog" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Session Watchdog" }],
      "Next": "Start Session Watchdog"
    },
    "Start Session Watchdog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${watchdog_state_machine_arn}",
        "Name.$": "States.Format('{}-watchdog', $.request.operationId)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-watchdog', $.request.operationId)",
          "sessionId.$": "$.request.sessionId",
          "registrationLeaseTtlSeconds.$": "$.request.watchdogRegistrationLeaseTtlSeconds",
          "stopLeaseTtlSeconds.$": "$.request.watchdogStopLeaseTtlSeconds",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "gameId.$": "$.request.gameId",
          "worldName.$": "$.request.worldName",
          "timing.$": "$.request.watchdogTiming",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.watchdog",
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.watchdogFailure",
        "Next": "Report Caught Before Acquire Watchdog Compensation Lease"
      }],
      "Next": "Ready"
    },
    "Report Caught Before Acquire Watchdog Compensation Lease": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.watchdogFailure.Error) = 'string' ? $substring($states.input.watchdogFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.watchdogFailure.Cause) = 'string' ? $substring($states.input.watchdogFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.undoing" }, ":step": { "S": "start.undoing" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Acquire Watchdog Compensation Lease" }],
      "Next": "Acquire Watchdog Compensation Lease"
    },
    "Acquire Watchdog Compensation Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-watchdog-compensation', $.request.operationId)",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Begin Compensating Stop"
    },
    "Report Ready": {
      "Type": "Task",
      "Comment": "The record ends as succeeded (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #result = :result, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#result": "result", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "succeeded" }, ":result": { "S": "{% $type($states.input.status) = 'string' ? $substring($states.input.status, 0, 1000) : '' %}" }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Report Ready Missed" }],
      "End": true
    },
    "Report Ready Missed": {
      "Type": "Succeed",
      "Comment": "The record could not be written; the run still succeeded (ADR-0105).",
      "QueryLanguage": "JSONata"
    },
    "Ready": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "serverId.$": "$.request.serverId",
        "status": "ready",
        "connectivity.$": "$.hostStart.Output.connectivity",
        "connectionAddress.$": "$.hostStart.Output.connectionAddress",
        "hostStart.$": "$.hostStart.Output"
      },
      "Next": "Report Ready"
    },
    "Report Caught Before Begin Compensating Stop": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.startFailure.Error) = 'string' ? $substring($states.input.startFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.startFailure.Cause) = 'string' ? $substring($states.input.startFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.undoing" }, ":step": { "S": "start.undoing" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Begin Compensating Stop" }],
      "Next": "Begin Compensating Stop"
    },
    "Report Begin Compensating Stop": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "start.undoing" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Begin Compensating Stop" }],
      "Next": "Begin Compensating Stop"
    },
    "Begin Compensating Stop": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Stop Accepted V1"
    },
    "Stop Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-compensate', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.stopTiming",
          "operationParent.$": "$$.Execution.Name",
          "operationRoot.$": "$operationRoot"
        }
      },
      "ResultPath": "$.hostStop",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.stopFailure",
          "Next": "Report Caught Before Force Stop Failed Start Host"
        }
      ],
      "Next": "Route Session Volume Release After Failed Start"
    },
    "Report Caught Before Force Stop Failed Start Host": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.stopFailure.Error) = 'string' ? $substring($states.input.stopFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.stopFailure.Cause) = 'string' ? $substring($states.input.stopFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.forcing_stop" }, ":step": { "S": "start.forcing_stop" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Force Stop Failed Start Host" }],
      "Next": "Force Stop Failed Start Host"
    },
    "Force Stop Failed Start Host": {
      "Type": "Task",
      "Comment": "The verified stop could not run because the game never became healthy enough to save or probe. Stop the billed host as the final cost-safety boundary; the persistent volume remains attached for recovery.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultPath": "$.coordination.forcedStopRequest",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.forcedStopFailure",
        "Next": "Report Caught Before Route Unstoppable Host"
      }],
      "Next": "Wait Before Forced Stop Poll"
    },
    "Report Caught Before Route Unstoppable Host": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.forcedStopFailure.Error) = 'string' ? $substring($states.input.forcedStopFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.forcedStopFailure.Cause) = 'string' ? $substring($states.input.forcedStopFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.forcing_stop" }, ":step": { "S": "start.forcing_stop" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Unstoppable Host" }],
      "Next": "Route Unstoppable Host"
    },
    "Route Unstoppable Host": {
      "Type": "Choice",
      "Comment": "A one-time Spot host cannot be stopped (ADR-0102). A fleet host is launched and disposable, and its session volume lives apart from it, so it is terminated rather than left billing. The configured host is never terminated.",
      "Choices": [{
        "Variable": "$.request.placement",
        "StringEquals": "fleet",
        "Next": "Terminate Unstoppable Fleet Host"
      }],
      "Default": "Report Start Compensation Failed"
    },
    "Terminate Unstoppable Fleet Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:terminateInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultPath": "$.coordination.forcedTermination",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.forcedTerminationFailure",
        "Next": "Report Start Compensation Failed"
      }],
      "Next": "Report Start Compensation Failed"
    },
    "Wait Before Forced Stop Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.stopTiming.instancePollSeconds",
      "Next": "Describe Forced Stop Host"
    },
    "Describe Forced Stop Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultPath": "$.coordination.forcedStopInstance",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.forcedStopFailure",
        "Next": "Report Start Compensation Failed"
      }],
      "Next": "Forced Stop Host Stopped"
    },
    "Forced Stop Host Stopped": {
      "Type": "Choice",
      "Choices": [{
        "Variable": "$.coordination.forcedStopInstance.Reservations[0].Instances[0].State.Name",
        "StringEquals": "stopped",
        "Next": "Mark Forced Session Stopped"
      }],
      "Default": "Increment Forced Stop Poll"
    },
    "Increment Forced Stop Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "coordination": {
          "lease.$": "$.coordination.lease",
          "forcedStopPolls.$": "States.MathAdd($.coordination.forcedStopPolls, 1)"
        },
        "startFailure.$": "$.startFailure",
        "stopFailure.$": "$.stopFailure"
      },
      "Next": "Forced Stop Poll Limit Reached"
    },
    "Forced Stop Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [{
        "Variable": "$.coordination.forcedStopPolls",
        "NumericGreaterThanEqualsPath": "$.request.stopTiming.maxInstancePolls",
        "Next": "Report Start Compensation Failed"
      }],
      "Default": "Wait Before Forced Stop Poll"
    },
    "Mark Forced Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Close Forced Session History"
    },
    "Close Forced Session History": {
      "Type": "Task",
      "Comment": "Ends the session in the metrics history (ADR-0015). Best effort: a missed close is ended by the next session or by the stop time.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "closeSessionHistory",
          "worldId.$": "$.request.worldId",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.sessionHistoryFailure",
          "Next": "Report Caught Before Release Forced Placement"
        }
      ],
      "Next": "Release Forced Placement"
    },
    "Report Caught Before Release Forced Placement": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionHistoryFailure.Error) = 'string' ? $substring($states.input.sessionHistoryFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionHistoryFailure.Cause) = 'string' ? $substring($states.input.sessionHistoryFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.forcing_stop" }, ":step": { "S": "start.forcing_stop" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Forced Placement" }],
      "Next": "Release Forced Placement"
    },
    "Release Forced Placement": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releasePlacement",
          "hostId.$": "$.request.placed.hostId",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": { "host.$": "$.Payload.host" },
      "ResultPath": "$.placementRelease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.placementReleaseError", "Next": "Report Caught Before Release Forced Compensation Lease" }],
      "Next": "Release Forced Compensation Lease"
    },
    "Report Caught Before Release Forced Compensation Lease": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.placementReleaseError.Error) = 'string' ? $substring($states.input.placementReleaseError.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.placementReleaseError.Cause) = 'string' ? $substring($states.input.placementReleaseError.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.forcing_stop" }, ":step": { "S": "start.forcing_stop" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Forced Compensation Lease" }],
      "Next": "Release Forced Compensation Lease"
    },
    "Release Forced Compensation Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Route Forced Fleet Drain"
    },
    "Route Forced Fleet Drain": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.placementReleaseError", "IsPresent": true, "Next": "Report Start Compensation Host Not Drained" },
        {
          "And": [
            { "Variable": "$.placementRelease.host.record.state", "StringEquals": "draining" },
            { "Variable": "$.placementRelease.host.record.provenance", "StringEquals": "launched" }
          ],
          "Next": "Start Forced Host Drain"
        }
      ],
      "Default": "Report Start Failed Host Forced Stopped"
    },
    "Start Forced Host Drain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${drain_state_machine_arn}",
        "Name.$": "States.Format('{}-failed-start-drain', $.request.operationId)",
        "Input": {
          "hostId.$": "$.request.placed.hostId",
          "emptiedBy.$": "$.request.sessionId",
          "immediate": true
        }
      },
      "ResultPath": "$.drain",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.drainStartFailure", "Next": "Report Start Compensation Host Not Drained" }],
      "Next": "Report Start Failed Host Forced Stopped"
    },
    "Report Start Failed Host Forced Stopped": {
      "Type": "Task",
      "Comment": "The record ends as failed (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #error = :error, #cause = :cause, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#error": "error", "#cause": "cause", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "failed" }, ":error": { "S": "Spawnpoint.V2StartFailedHostForcedStopped" }, ":cause": { "S": "The host start and verified stop both failed; EC2 was forcibly stopped and its persistent volume was retained for recovery." }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Failed Host Forced Stopped" }],
      "Next": "Start Failed Host Forced Stopped"
    },
    "Start Failed Host Forced Stopped": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartFailedHostForcedStopped",
      "Cause": "The host start and verified stop both failed; EC2 was forcibly stopped and its persistent volume was retained for recovery."
    },
    "Route Session Volume Release After Failed Start": {
      "Type": "Choice",
      "Comment": "ADR-0102: the archive is verified, so the session volume is let go. Every failure below leaves the volume to the session volume sweeper and the stop goes on.",
      "Choices": [
        {
          "Variable": "$.sessionVolume.mode",
          "StringEquals": "enabled",
          "Next": "Find Session Volume After Failed Start"
        }
      ],
      "Default": "Mark Compensated Session Stopped"
    },
    "Find Session Volume After Failed Start": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
      "Parameters": {
        "Filters": [
          {
            "Name": "tag:ManagedBy",
            "Values": [
              "${session_volume_managed_by}"
            ]
          },
          {
            "Name": "tag:${session_volume_session_tag}",
            "Values.$": "States.Array($.request.sessionId)"
          }
        ]
      },
      "ResultSelector": {
        "volumes.$": "$.Volumes"
      },
      "ResultPath": "$.sessionVolume.found",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Mark Compensated Session Stopped"
        }
      ],
      "Next": "Route Found Session Volume After Failed Start"
    },
    "Route Found Session Volume After Failed Start": {
      "Type": "Choice",
      "Comment": "A volume that is already available was detached by an earlier try. A host that keeps running for another session still has it mounted; a stopped host unmounted it when it shut down.",
      "Choices": [
        {
          "Variable": "$.sessionVolume.found.volumes[0]",
          "IsPresent": false,
          "Next": "Mark Compensated Session Stopped"
        },
        {
          "Variable": "$.sessionVolume.found.volumes[0].State",
          "StringEquals": "available",
          "Next": "Delete Session Volume After Failed Start"
        },
        {
          "Or": [
            { "Variable": "$.hostStop.Output.status", "StringEquals": "session_stopped_host_busy" },
            { "Variable": "$.hostStop.Output.status", "StringEquals": "session_stopped_spot_host" }
          ],
          "Next": "Unmount Session Volume After Failed Start"
        }
      ],
      "Default": "Detach Session Volume After Failed Start"
    },
    "Unmount Session Volume After Failed Start": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-unmount-session-volume",
        "InstanceIds.$": "States.Array($.request.placed.hostId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)"
        },
        "TimeoutSeconds": 300,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultSelector": {
        "commandId.$": "$.Command.CommandId"
      },
      "ResultPath": "$.sessionVolume.unmount",
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Mark Compensated Session Stopped"
        }
      ],
      "Next": "Wait Before Unmount Poll After Failed Start"
    },
    "Wait Before Unmount Poll After Failed Start": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Get Unmount Command After Failed Start"
    },
    "Get Unmount Command After Failed Start": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
      "Parameters": {
        "CommandId.$": "$.sessionVolume.unmount.commandId",
        "InstanceId.$": "$.request.placed.hostId"
      },
      "ResultSelector": {
        "status.$": "$.Status"
      },
      "ResultPath": "$.sessionVolume.observed",
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Ssm.InvocationDoesNotExistException"
          ],
          "ResultPath": "$.sessionVolume.lookupError",
          "Next": "Report Caught Before Count Unmount Poll After Failed Start"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Mark Compensated Session Stopped"
        }
      ],
      "Next": "Unmount Complete After Failed Start"
    },
    "Unmount Complete After Failed Start": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.observed.status",
          "StringEquals": "Success",
          "Next": "Detach Session Volume After Failed Start"
        },
        {
          "Or": [
            {
              "Variable": "$.sessionVolume.observed.status",
              "StringEquals": "Pending"
            },
            {
              "Variable": "$.sessionVolume.observed.status",
              "StringEquals": "InProgress"
            },
            {
              "Variable": "$.sessionVolume.observed.status",
              "StringEquals": "Delayed"
            }
          ],
          "Next": "Count Unmount Poll After Failed Start"
        }
      ],
      "Default": "Mark Compensated Session Stopped"
    },
    "Report Caught Before Count Unmount Poll After Failed Start": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionVolume.lookupError.Error) = 'string' ? $substring($states.input.sessionVolume.lookupError.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionVolume.lookupError.Cause) = 'string' ? $substring($states.input.sessionVolume.lookupError.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.undoing" }, ":step": { "S": "start.undoing" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Count Unmount Poll After Failed Start" }],
      "Next": "Count Unmount Poll After Failed Start"
    },
    "Count Unmount Poll After Failed Start": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.sessionVolume.unmountPolls.count, 1)"
      },
      "ResultPath": "$.sessionVolume.unmountPolls",
      "Next": "Unmount Poll Limit Reached After Failed Start"
    },
    "Unmount Poll Limit Reached After Failed Start": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.unmountPolls.count",
          "NumericGreaterThanEquals": 30,
          "Next": "Mark Compensated Session Stopped"
        }
      ],
      "Default": "Wait Before Unmount Poll After Failed Start"
    },
    "Detach Session Volume After Failed Start": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:detachVolume",
      "Parameters": {
        "VolumeId.$": "$.sessionVolume.found.volumes[0].VolumeId",
        "InstanceId.$": "$.request.placed.hostId"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Mark Compensated Session Stopped"
        }
      ],
      "Next": "Wait Before Detach Poll After Failed Start"
    },
    "Wait Before Detach Poll After Failed Start": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Describe Detached Session Volume After Failed Start"
    },
    "Describe Detached Session Volume After Failed Start": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
      "Parameters": {
        "VolumeIds.$": "States.Array($.sessionVolume.found.volumes[0].VolumeId)"
      },
      "ResultSelector": {
        "state.$": "$.Volumes[0].State"
      },
      "ResultPath": "$.sessionVolume.observed",
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Mark Compensated Session Stopped"
        }
      ],
      "Next": "Session Volume Detached After Failed Start"
    },
    "Session Volume Detached After Failed Start": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.observed.state",
          "StringEquals": "available",
          "Next": "Delete Session Volume After Failed Start"
        }
      ],
      "Default": "Count Detach Poll After Failed Start"
    },
    "Count Detach Poll After Failed Start": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.sessionVolume.detachPolls.count, 1)"
      },
      "ResultPath": "$.sessionVolume.detachPolls",
      "Next": "Detach Poll Limit Reached After Failed Start"
    },
    "Detach Poll Limit Reached After Failed Start": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sessionVolume.detachPolls.count",
          "NumericGreaterThanEquals": 30,
          "Next": "Mark Compensated Session Stopped"
        }
      ],
      "Default": "Wait Before Detach Poll After Failed Start"
    },
    "Delete Session Volume After Failed Start": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:deleteVolume",
      "Parameters": {
        "VolumeId.$": "$.sessionVolume.found.volumes[0].VolumeId"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Ec2.RequestLimitExceededException",
            "Ec2.RequestLimitExceeded"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.sessionVolumeFailure",
          "Next": "Report Caught Before Mark Compensated Session Stopped"
        }
      ],
      "Next": "Mark Compensated Session Stopped"
    },
    "Report Caught Before Mark Compensated Session Stopped": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionVolumeFailure.Error) = 'string' ? $substring($states.input.sessionVolumeFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionVolumeFailure.Cause) = 'string' ? $substring($states.input.sessionVolumeFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.undoing" }, ":step": { "S": "start.undoing" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Mark Compensated Session Stopped" }],
      "Next": "Mark Compensated Session Stopped"
    },
    "Mark Compensated Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Close Compensated Session History"
    },
    "Close Compensated Session History": {
      "Type": "Task",
      "Comment": "Ends the session in the metrics history (ADR-0015). Best effort: a missed close is ended by the next session or by the stop time.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "closeSessionHistory",
          "worldId.$": "$.request.worldId",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.sessionHistoryFailure",
          "Next": "Report Caught Before Release Compensated Placement"
        }
      ],
      "Next": "Release Compensated Placement"
    },
    "Report Caught Before Release Compensated Placement": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.sessionHistoryFailure.Error) = 'string' ? $substring($states.input.sessionHistoryFailure.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.sessionHistoryFailure.Cause) = 'string' ? $substring($states.input.sessionHistoryFailure.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.undoing" }, ":step": { "S": "start.undoing" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Compensated Placement" }],
      "Next": "Release Compensated Placement"
    },
    "Release Compensated Placement": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releasePlacement",
          "hostId.$": "$.request.placed.hostId",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultSelector": { "host.$": "$.Payload.host" },
      "ResultPath": "$.placementRelease",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.placementReleaseError", "Next": "Report Caught Before Release Compensating Lease" }],
      "Next": "Release Compensating Lease"
    },
    "Report Caught Before Release Compensating Lease": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.placementReleaseError.Error) = 'string' ? $substring($states.input.placementReleaseError.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.placementReleaseError.Cause) = 'string' ? $substring($states.input.placementReleaseError.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "start.undoing" }, ":step": { "S": "start.undoing" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Release Compensating Lease" }],
      "Next": "Release Compensating Lease"
    },
    "Release Compensating Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Route Compensated Fleet Drain"
    },
    "Route Compensated Fleet Drain": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.placementReleaseError", "IsPresent": true, "Next": "Report Start Compensation Host Not Drained" },
        {
          "And": [
            { "Variable": "$.placementRelease.host.record.state", "StringEquals": "draining" },
            { "Variable": "$.placementRelease.host.record.provenance", "StringEquals": "launched" }
          ],
          "Next": "Start Compensated Host Drain"
        }
      ],
      "Default": "Report Start Failed And Compensated"
    },
    "Start Compensated Host Drain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${drain_state_machine_arn}",
        "Name.$": "States.Format('{}-failed-start-drain', $.request.operationId)",
        "Input": {
          "hostId.$": "$.request.placed.hostId",
          "emptiedBy.$": "$.request.sessionId",
          "immediate": true
        }
      },
      "ResultPath": "$.drain",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.drainStartFailure", "Next": "Report Start Compensation Host Not Drained" }],
      "Next": "Report Start Failed And Compensated"
    },
    "Report Start Failed And Compensated": {
      "Type": "Task",
      "Comment": "The record ends as failed (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #error = :error, #cause = :cause, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#error": "error", "#cause": "cause", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "failed" }, ":error": { "S": "Spawnpoint.V2StartFailedCompensated" }, ":cause": { "S": "The host start or required watchdog launch failed; the host was stopped and lifecycle state returned to stopped." }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Failed And Compensated" }],
      "Next": "Start Failed And Compensated"
    },
    "Start Failed And Compensated": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartFailedCompensated",
      "Cause": "The host start or required watchdog launch failed; the host was stopped and lifecycle state returned to stopped."
    },
    "Report Start Compensation Failed": {
      "Type": "Task",
      "Comment": "The record ends as failed (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #error = :error, #cause = :cause, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#error": "error", "#cause": "cause", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "failed" }, ":error": { "S": "Spawnpoint.V2StartCompensationFailed" }, ":cause": { "S": "Host start, verified stop compensation and the final EC2 stop safeguard did not all complete; lifecycle remains stopping for explicit recovery and the running-hours alarm remains the backstop." }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Compensation Failed" }],
      "Next": "Start Compensation Failed"
    },
    "Start Compensation Failed": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartCompensationFailed",
      "Cause": "Host start, verified stop compensation and the final EC2 stop safeguard did not all complete; lifecycle remains stopping for explicit recovery and the running-hours alarm remains the backstop."
    },
    "Report Start Compensation Host Not Drained": {
      "Type": "Task",
      "Comment": "The record ends as failed (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #error = :error, #cause = :cause, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#error": "error", "#cause": "cause", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "failed" }, ":error": { "S": "Spawnpoint.V2StartHostNotDrained" }, ":cause": { "S": "The failed session was stopped, but its host reservation could not be released or the empty launched host could not be drained. The running-hours alarm remains the backstop." }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Start Compensation Host Not Drained" }],
      "Next": "Start Compensation Host Not Drained"
    },
    "Start Compensation Host Not Drained": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartHostNotDrained",
      "Cause": "The failed session was stopped, but its host reservation could not be released or the empty launched host could not be drained. The running-hours alarm remains the backstop."
    }
  }
}
