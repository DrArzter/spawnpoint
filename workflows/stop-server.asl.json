{
  "Comment": "Back up a quiet Spawnpoint session and stop its EC2 host.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Report Accepted",
  "States": {
    "Report Accepted": {
      "Type": "Task",
      "Comment": "The run's record: accepted, and running (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": "{% ($f := $merge([{'operation_id': {'S': $states.context.Execution.Name}, 'execution_arn': {'S': $states.context.Execution.Id}, 'type': {'S': 'stop'}, 'workflow': {'S': 'stop-host'}, 'status': {'S': 'running'}, 'root_id': {'S': ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name)}, 'started_at': {'S': $states.context.Execution.StartTime}, 'updated_at': {'S': $states.context.State.EnteredTime}, 'open_key': {'S': 'open'}, 'expires_at': {'N': $string($floor($toMillis($states.context.Execution.StartTime) / 1000) + 2592000)}, 'step': {'S': 'stop.checking_host'}}, $type($states.context.Execution.Input.worldId) = 'string' ? {'world_id': {'S': $states.context.Execution.Input.worldId}} : {}, $type($states.context.Execution.Input.gameId) = 'string' ? {'game_id': {'S': $states.context.Execution.Input.gameId}} : {}, $type($states.context.Execution.Input.serverId) = 'string' ? {'server_id': {'S': $states.context.Execution.Input.serverId}} : {}, $type($states.context.Execution.Input.operationParent) = 'string' ? {'parent_id': {'S': $states.context.Execution.Input.operationParent}} : {}, $type($states.context.Execution.Input.instanceId) = 'string' ? {'host_instance_id': {'S': $states.context.Execution.Input.instanceId}} : {}]); {'TableName': '${operation_table_name}', 'Key': {'pk': {'S': 'OPERATION#' & $states.context.Execution.Name}, 'sk': {'S': 'RECORD'}}, 'UpdateExpression': 'SET ' & $join($map($keys($f), function($k) { '#' & $k & ' = :' & $k }), ', '), 'ExpressionAttributeNames': $merge($map($keys($f), function($k) { {'#' & $k: $k} })), 'ExpressionAttributeValues': $merge($map($keys($f), function($k) { {':' & $k: $lookup($f, $k)} }))}) %}",
      "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Assign": { "operationRoot": "{% ($exists($states.context.Execution.Input.operationRoot) ? $states.context.Execution.Input.operationRoot : $states.context.Execution.Name) %}" }, "Output": "{% $states.input %}", "Next": "Route Operation Parent" }],
      "Next": "Route Operation Parent"
    },
    "Route Operation Parent": {
      "Type": "Choice",
      "Comment": "A nested run names itself on its parent's record (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Choices": [{ "Condition": "{% $type($states.context.Execution.Input.operationParent) = 'string' %}", "Next": "Report Child To Parent" }],
      "Default": "Initialize",
      "Output": "{% $states.input %}"
    },
    "Report Child To Parent": {
      "Type": "Task",
      "Comment": "The parent's record names its newest nested run (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Input.operationParent %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #child_id = :child_id, #updated_at = :updated_at",
        "ExpressionAttributeNames": { "#child_id": "child_id", "#updated_at": "updated_at" },
        "ExpressionAttributeValues": { ":child_id": { "S": "{% $states.context.Execution.Name %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Initialize" }],
      "Next": "Initialize"
    },
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "defaults": {
          "players": "refuse"
        },
        "polls": {
          "ssm": 0,
          "command": 0,
          "instance": 0
        },
        "observed": {}
      },
      "Next": "Apply Request Defaults"
    },
    "Apply Request Defaults": {
      "Type": "Pass",
      "Comment": "A caller that names no players policy refuses a stop while players are online.",
      "Parameters": {
        "request.$": "States.JsonMerge($.defaults, $.request, false)",
        "polls.$": "$.polls",
        "observed.$": "$.observed"
      },
      "Next": "Route Players Policy"
    },
    "Route Players Policy": {
      "Type": "Choice",
      "Comment": "The policy reaches the host's shell command, so only the two known words pass.",
      "Choices": [
        {
          "Or": [
            { "Variable": "$.request.players", "StringEquals": "refuse" },
            { "Variable": "$.request.players", "StringEquals": "disconnect" }
          ],
          "Next": "Describe Initial Instance"
        }
      ],
      "Default": "Report Unknown Players Policy"
    },
    "Report Unknown Players Policy": {
      "Type": "Task",
      "Comment": "The record ends as failed (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #error = :error, #cause = :cause, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#error": "error", "#cause": "cause", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":status": { "S": "failed" }, ":error": { "S": "Spawnpoint.InvalidStopRequest" }, ":cause": { "S": "The players policy must be refuse or disconnect; EC2 was not touched." }, ":ended_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Unknown Players Policy" }],
      "Next": "Unknown Players Policy"
    },
    "Unknown Players Policy": {
      "Type": "Fail",
      "Error": "Spawnpoint.InvalidStopRequest",
      "Cause": "The players policy must be refuse or disconnect; EC2 was not touched."
    },
    "Describe Initial Instance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultPath": "$.observed.instance",
      "Next": "Route Initial Instance State"
    },
    "Route Initial Instance State": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
          "StringEquals": "stopped",
          "Next": "Already Stopped"
        },
        {
          "Variable": "$.observed.instance.Reservations[0].Instances[0].State.Name",
          "StringEquals": "running",
          "Next": "Report Wait Before SSM Poll"
        }
      ],
      "Default": "Report Instance Cannot Stop"
    },
    "Report Wait Before SSM Poll": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.waiting_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Wait Before SSM Poll" }],
      "Next": "Wait Before SSM Poll"
    },
    "Wait Before SSM Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.timing.ssmPollSeconds",
      "Next": "Describe SSM Agent"
    },
    "Describe SSM Agent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
      "Parameters": {
        "Filters": [
          {
            "Key": "InstanceIds",
            "Values.$": "States.Array($.request.instanceId)"
          }
        ]
      },
      "ResultPath": "$.observed.ssm",
      "Next": "SSM Record Present"
    },
    "SSM Record Present": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.ssm.InstanceInformationList[0]",
          "IsPresent": true,
          "Next": "SSM Agent Online"
        }
      ],
      "Default": "Increment SSM Poll"
    },
    "SSM Agent Online": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.observed.ssm.InstanceInformationList[0].PingStatus",
          "StringEquals": "Online",
          "Next": "Report Route Stop Command"
        }
      ],
      "Default": "Increment SSM Poll"
    },
    "Increment SSM Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "polls": {
          "ssm.$": "States.MathAdd($.polls.ssm, 1)",
          "command.$": "$.polls.command",
          "instance.$": "$.polls.instance"
        },
        "observed": {}
      },
      "Next": "SSM Poll Limit Reached"
    },
    "SSM Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.polls.ssm",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxSsmPolls",
          "Next": "Report SSM Timed Out"
        }
      ],
      "Default": "Wait Before SSM Poll"
    },
    "Report Route Stop Command": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.saving_world" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Route Stop Command" }],
      "Next": "Route Stop Command"
    },
    "Route Stop Command": {
      "Type": "Choice",
      "Comment": "ADR-0054: a placed session is stopped in its own Compose project, which its slot names. A request with no slot runs the command it always ran.",
      "Choices": [
        {
          "Variable": "$.request.slot",
          "IsPresent": true,
          "Next": "Stop Placed Session Command"
        }
      ],
      "Default": "Stop Session Command"
    },
    "Stop Placed Session Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-stop-session",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)",
          "slot.$": "States.Array(States.Format('{}', $.request.slot))",
          "players.$": "States.Array($.request.players)"
        },
        "TimeoutSeconds": 900,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultPath": "$.observed.command",
      "Next": "Report Command"
    },
    "Stop Session Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "spawnpoint-stop-session",
        "InstanceIds.$": "States.Array($.request.instanceId)",
        "Parameters": {
          "worldId.$": "States.Array($.request.worldId)",
          "players.$": "States.Array($.request.players)"
        },
        "TimeoutSeconds": 900,
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "/spawnpoint/session-commands",
          "CloudWatchOutputEnabled": true
        }
      },
      "ResultPath": "$.observed.command",
      "Next": "Report Command"
    },
    "Report Command": {
      "Type": "Task",
      "Comment": "The record names the host command, for the log (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #command_id = :command_id, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#command_id": "command_id", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":command_id": { "S": "{% $states.input.observed.command.Command.CommandId %}" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Wait Before Command Poll" }],
      "Next": "Wait Before Command Poll"
    },
    "Wait Before Command Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.timing.commandPollSeconds",
      "Next": "Get Stop Command"
    },
    "Get Stop Command": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
      "Parameters": {
        "CommandId.$": "$.observed.command.Command.CommandId",
        "InstanceId.$": "$.request.instanceId"
      },
      "ResultPath": "$.observed.invocation",
      "Catch": [
        {
          "ErrorEquals": [
            "Ssm.InvocationDoesNotExistException"
          ],
          "ResultPath": "$.observed.commandLookupError",
          "Next": "Report Caught Before Increment Command Poll"
        }
      ],
      "Next": "Stop Command Complete"
    },
    "Stop Command Complete": {
      "Type": "Choice",
      "Comment": "ADR-0073: a stop succeeds only on the line that says the world's archive is verified on this host. SSM Success alone is not that proof.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Success"
            },
            {
              "Or": [
                {
                  "Variable": "$.observed.invocation.StandardOutputContent",
                  "StringMatches": "*result=session_stopped_and_backed_up*"
                },
                {
                  "Variable": "$.observed.invocation.StandardOutputContent",
                  "StringMatches": "*result=already_stopped_and_backed_up*"
                }
              ]
            }
          ],
          "Next": "Report Describe Host Market"
        },
        {
          "And": [
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Failed"
            },
            {
              "Variable": "$.observed.invocation.ResponseCode",
              "NumericEquals": 6
            }
          ],
          "Next": "Report World Not On Host"
        },
        {
          "And": [
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Failed"
            },
            {
              "Variable": "$.observed.invocation.ResponseCode",
              "NumericEquals": 3
            }
          ],
          "Next": "Report Players Online"
        },
        {
          "And": [
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Failed"
            },
            {
              "Variable": "$.observed.invocation.ResponseCode",
              "NumericEquals": 4
            }
          ],
          "Next": "Host Still Busy"
        },
        {
          "And": [
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Failed"
            },
            {
              "Variable": "$.observed.invocation.ResponseCode",
              "NumericEquals": 5
            }
          ],
          "Next": "Report Host Activity Unknown"
        },
        {
          "Or": [
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Pending"
            },
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "InProgress"
            },
            {
              "Variable": "$.observed.invocation.Status",
              "StringEquals": "Delayed"
            }
          ],
          "Next": "Increment Command Poll"
        }
      ],
      "Default": "Report Session Stop Failed"
    },
    "Report Caught Before Increment Command Poll": {
      "Type": "Task",
      "Comment": "The record keeps the failure the workflow caught and went on from (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #caught_error = :caught_error, #caught_cause = :caught_cause, #caught_step = :caught_step, #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#caught_error": "caught_error", "#caught_cause": "caught_cause", "#caught_step": "caught_step", "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":caught_error": { "S": "{% $type($states.input.observed.commandLookupError.Error) = 'string' ? $substring($states.input.observed.commandLookupError.Error, 0, 1000) : '' %}" }, ":caught_cause": { "S": "{% $type($states.input.observed.commandLookupError.Cause) = 'string' ? $substring($states.input.observed.commandLookupError.Cause, 0, 1000) : '' %}" }, ":caught_step": { "S": "stop.saving_world" }, ":step": { "S": "stop.saving_world" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Increment Command Poll" }],
      "Next": "Increment Command Poll"
    },
    "Increment Command Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "polls": {
          "ssm.$": "$.polls.ssm",
          "command.$": "States.MathAdd($.polls.command, 1)",
          "instance.$": "$.polls.instance"
        },
        "observed": {
          "command.$": "$.observed.command"
        }
      },
      "Next": "Command Poll Limit Reached"
    },
    "Command Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.polls.command",
          "NumericGreaterThanEqualsPath": "$.request.timing.maxCommandPolls",
          "Next": "Report Session Stop Timed Out"
        }
      ],
      "Default": "Wait Before Command Poll"
    },
    "Report Describe Host Market": {
      "Type": "Task",
      "Comment": "The record names the step the panel shows (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #step = :step, #updated_at = :updated_at, #open_key = :open_key",
        "ExpressionAttributeNames": { "#step": "step", "#updated_at": "updated_at", "#open_key": "open_key" },
        "ExpressionAttributeValues": { ":step": { "S": "stop.stopping_host" }, ":updated_at": { "S": "{% $states.context.State.EnteredTime %}" }, ":open_key": { "S": "open" } }
      },
      "Output": "{% $states.input %}",
      "Retry": [{ "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "MaxAttempts": 0 }, { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.input %}", "Next": "Describe Host Market" }],
      "Next": "Describe Host Market"
    },
    "Describe Host Market": {
      "Type": "Task",
      "Comment": "ADR-0102: a launched Spot host is a one-time request, and EC2 refuses to stop one. The world is already backed up here, so its host is left running empty for the V2 stop to release and the drain to let go.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultSelector": {
        "lifecycle.$": "$.Reservations[0].Instances[0]"
      },
      "ResultPath": "$.observed.market",
      "Next": "Host Is Spot"
    },
    "Host Is Spot": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.observed.market.lifecycle.InstanceLifecycle", "IsPresent": true },
            { "Variable": "$.observed.market.lifecycle.InstanceLifecycle", "StringEquals": "spot" }
          ],
          "Next": "Spot Host Left For Drain"
        }
      ],
      "Default": "Stop Instance"
    },
    "Report Spot Host Left For Drain": {
      "Type": "Task",
      "Comment": "The record ends as succeeded (ADR-0105).",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${operation_table_name}",
        "Key": { "pk": { "S": "{% 'OPERATION#' & $states.context.Execution.Name %}" }, "sk": { "S": "RECORD" } },
        "ConditionExpression": "attribute_exists(pk)",
        "UpdateExpression": "SET #status = :status, #result = :result, #ended_at = :ended_at, #updated_at = :updated_at REMOVE #open_key",
        "ExpressionAttributeNames": { "#status": "status", "#result": "result", "#ended_at": "ended_at", "#updated_at": "updated_at", "#open_key": "open_key" },
