{
  "Comment": "Lifecycle V2 start wrapper: fence one session, delegate host work to accepted V1, and compensate a failed start.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Initialize",
  "States": {
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$",
        "coordination": {
          "forcedStopPolls": 0
        }
      },
      "Next": "Initialize Lifecycle"
    },
    "Initialize Lifecycle": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "initialize",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Acquire Start Lease"
    },
    "Acquire Start Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "$.request.operationId",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Next": "Begin Session"
    },
    "Begin Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginSession",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId"
        }
      },
      "ResultPath": null,
      "Next": "Route Placement Mode"
    },
    "Route Placement Mode": {
      "Type": "Choice",
      "Comment": "ADR-0054. `single` starts the configured instance as before. `shared` registers that instance and asks the coordinator for a host with room; the answer names the host and the slot every host command carries from here on.",
      "Choices": [
        {
          "Variable": "$.request.placement",
          "StringEquals": "shared",
          "Next": "Describe Configured Host"
        }
      ],
      "Default": "Adopt Configured Host"
    },
    "Adopt Configured Host": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.request.instanceId",
        "slot": ""
      },
      "ResultPath": "$.request.placed",
      "Next": "Start Accepted V1"
    },
    "Describe Configured Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultSelector": {
        "instanceType.$": "$.Reservations[0].Instances[0].InstanceType"
      },
      "ResultPath": "$.host",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Describe Configured Host Shape"
    },
    "Describe Configured Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.host.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.host.shape",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Register Configured Host"
    },
    "Register Configured Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.request.instanceId",
          "ready": true,
          "shape": {
            "instanceType.$": "$.host.instanceType",
            "memoryMiB.$": "$.host.shape.memoryMiB",
            "vcpu.$": "$.host.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Place Session"
    },
    "Place Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "placeSession",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Placement Unavailable"
        }
      ],
      "Next": "Route Placement"
    },
    "Route Placement": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.placement.placement.kind",
          "StringEquals": "reuse",
          "Next": "Adopt Placement"
        }
      ],
      "Default": "No Host Has Room"
    },
    "Adopt Placement": {
      "Type": "Pass",
      "Parameters": {
        "hostId.$": "$.placement.placement.hostId",
        "slot.$": "$.placement.placement.slot"
      },
      "ResultPath": "$.request.placed",
      "Next": "Start Accepted V1"
    },
    "No Host Has Room": {
      "Type": "Pass",
      "Comment": "The coordinator answered with what to launch, and launching is not built yet (ADR-0054, phase 12). The session is cancelled cleanly rather than started on a host that has no room for it.",
      "Result": { "reason": "no_host_has_room" },
      "ResultPath": "$.placementRefusal",
      "Next": "Begin Cancelling Unplaced Session"
    },
    "Placement Unavailable": {
      "Type": "Pass",
      "Result": { "reason": "placement_unavailable" },
      "ResultPath": "$.placementRefusal",
      "Next": "Begin Cancelling Unplaced Session"
    },
    "Begin Cancelling Unplaced Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Mark Unplaced Session Stopped"
    },
    "Mark Unplaced Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Unplaced Lease"
    },
    "Release Unplaced Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Start Refused Unplaced"
    },
    "Start Refused Unplaced": {
      "Type": "Fail",
      "Error": "Spawnpoint.SessionUnplaced",
      "Cause": "No registered host has room for this session and launching one is not built yet, or the placement could not be read. Nothing was started; the session was cancelled and its lease released."
    },
    "Start Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${start_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-host-start', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.startTiming"
        }
      },
      "ResultPath": "$.hostStart",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.startFailure",
          "Next": "Release Failed Placement"
        }
      ],
      "Next": "Route Bookkeeping"
    },
    "Route Bookkeeping": {
      "Type": "Choice",
      "Comment": "A placed session already holds its reservation. An unplaced one records the host it ran on and slot zero after the fact, as phase 5 did, and that bookkeeping may fail without failing the start.",
      "Choices": [
        {
          "Variable": "$.request.placement",
          "StringEquals": "shared",
          "Next": "Mark Session Ready"
        }
      ],
      "Default": "Describe Host"
    },
    "Describe Host": {
      "Type": "Task",
      "Comment": "Placement bookkeeping (ADR-0054, phase 5): the host that ran this session is recorded with its shape and the session's reservation on slot zero. Read by nobody yet, so a failure here must never fail a start that has already succeeded.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.instanceId)"
      },
      "ResultSelector": {
        "instanceType.$": "$.Reservations[0].Instances[0].InstanceType"
      },
      "ResultPath": "$.host",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Describe Host Shape"
    },
    "Describe Host Shape": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstanceTypes",
      "Parameters": {
        "InstanceTypes.$": "States.Array($.host.instanceType)"
      },
      "ResultSelector": {
        "memoryMiB.$": "$.InstanceTypes[0].MemoryInfo.SizeInMiB",
        "vcpu.$": "$.InstanceTypes[0].VCpuInfo.DefaultVCpus"
      },
      "ResultPath": "$.host.shape",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Register Host"
    },
    "Register Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "registerHost",
          "hostId.$": "$.request.instanceId",
          "ready": true,
          "shape": {
            "instanceType.$": "$.host.instanceType",
            "memoryMiB.$": "$.host.shape.memoryMiB",
            "vcpu.$": "$.host.shape.vcpu"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Reserve Slot Zero"
    },
    "Reserve Slot Zero": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "reserveOnHost",
          "hostId.$": "$.request.instanceId",
          "sessionId.$": "$.request.sessionId",
          "worldId.$": "$.request.worldId",
          "serverId.$": "$.request.serverId"
        }
      },
      "ResultSelector": {
        "placement.$": "$.Payload.placement"
      },
      "ResultPath": "$.placement",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Mark Session Ready"
        }
      ],
      "Next": "Mark Session Ready"
    },
    "Mark Session Ready": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markSessionReady",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Start Lease"
    },
    "Release Start Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Start Session Watchdog"
    },
    "Start Session Watchdog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:startExecution",
      "Parameters": {
        "StateMachineArn": "${watchdog_state_machine_arn}",
        "Name.$": "States.Format('{}-watchdog', $.request.operationId)",
        "Input": {
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-watchdog', $.request.operationId)",
          "sessionId.$": "$.request.sessionId",
          "registrationLeaseTtlSeconds.$": "$.request.watchdogRegistrationLeaseTtlSeconds",
          "stopLeaseTtlSeconds.$": "$.request.watchdogStopLeaseTtlSeconds",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.watchdogTiming",
          "stopTiming.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.watchdog",
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.watchdogFailure",
        "Next": "Acquire Watchdog Compensation Lease"
      }],
      "Next": "Ready"
    },
    "Acquire Watchdog Compensation Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "acquireLease",
          "serverId.$": "$.request.serverId",
          "operationId.$": "States.Format('{}-watchdog-compensation', $.request.operationId)",
          "ttlSeconds.$": "$.request.leaseTtlSeconds"
        }
      },
      "ResultSelector": {
        "ownership.$": "$.Payload.ownership"
      },
      "ResultPath": "$.coordination.lease",
      "Next": "Release Failed Placement"
    },
    "Release Failed Placement": {
      "Type": "Task",
      "Comment": "A session that will not be ready gives its slot back before the host is stopped. Releasing what was never reserved is not a failure.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releasePlacement",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.placementFailure",
          "Next": "Begin Compensating Stop"
        }
      ],
      "Next": "Begin Compensating Stop"
    },
    "Ready": {
      "Type": "Pass",
      "Parameters": {
        "operationId.$": "$.request.operationId",
        "sessionId.$": "$.request.sessionId",
        "serverId.$": "$.request.serverId",
        "status": "ready",
        "connectivity.$": "$.hostStart.Output.connectivity",
        "connectionAddress.$": "$.hostStart.Output.connectionAddress",
        "hostStart.$": "$.hostStart.Output"
      },
      "End": true
    },
    "Begin Compensating Stop": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "beginStopping",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Stop Accepted V1"
    },
    "Stop Accepted V1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${stop_v1_state_machine_arn}",
        "Name.$": "States.Format('{}-compensate', $.request.operationId)",
        "Input": {
          "operationId.$": "$.request.operationId",
          "instanceId.$": "$.request.placed.hostId",
          "slot.$": "$.request.placed.slot",
          "worldId.$": "$.request.worldId",
          "timing.$": "$.request.stopTiming"
        }
      },
      "ResultPath": "$.hostStop",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.stopFailure",
          "Next": "Force Stop Failed Start Host"
        }
      ],
      "Next": "Mark Compensated Session Stopped"
    },
    "Force Stop Failed Start Host": {
      "Type": "Task",
      "Comment": "The verified stop could not run because the game never became healthy enough to save or probe. Stop the billed host as the final cost-safety boundary; the persistent volume remains attached for recovery.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultPath": "$.coordination.forcedStopRequest",
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.forcedStopFailure",
        "Next": "Start Compensation Failed"
      }],
      "Next": "Wait Before Forced Stop Poll"
    },
    "Wait Before Forced Stop Poll": {
      "Type": "Wait",
      "SecondsPath": "$.request.stopTiming.instancePollSeconds",
      "Next": "Describe Forced Stop Host"
    },
    "Describe Forced Stop Host": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.request.placed.hostId)"
      },
      "ResultPath": "$.coordination.forcedStopInstance",
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.forcedStopFailure",
        "Next": "Start Compensation Failed"
      }],
      "Next": "Forced Stop Host Stopped"
    },
    "Forced Stop Host Stopped": {
      "Type": "Choice",
      "Choices": [{
        "Variable": "$.coordination.forcedStopInstance.Reservations[0].Instances[0].State.Name",
        "StringEquals": "stopped",
        "Next": "Mark Forced Session Stopped"
      }],
      "Default": "Increment Forced Stop Poll"
    },
    "Increment Forced Stop Poll": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "coordination": {
          "lease.$": "$.coordination.lease",
          "forcedStopPolls.$": "States.MathAdd($.coordination.forcedStopPolls, 1)"
        },
        "startFailure.$": "$.startFailure",
        "stopFailure.$": "$.stopFailure"
      },
      "Next": "Forced Stop Poll Limit Reached"
    },
    "Forced Stop Poll Limit Reached": {
      "Type": "Choice",
      "Choices": [{
        "Variable": "$.coordination.forcedStopPolls",
        "NumericGreaterThanEqualsPath": "$.request.stopTiming.maxInstancePolls",
        "Next": "Start Compensation Failed"
      }],
      "Default": "Wait Before Forced Stop Poll"
    },
    "Mark Forced Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Forced Compensation Lease"
    },
    "Release Forced Compensation Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Start Failed Host Forced Stopped"
    },
    "Start Failed Host Forced Stopped": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartFailedHostForcedStopped",
      "Cause": "The host start and verified stop both failed; EC2 was forcibly stopped and its persistent volume was retained for recovery."
    },
    "Mark Compensated Session Stopped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "markStopped",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership",
          "sessionId.$": "$.request.sessionId"
        }
      },
      "ResultPath": null,
      "Next": "Release Compensating Lease"
    },
    "Release Compensating Lease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${coordinator_function_arn}",
        "Payload": {
          "action": "releaseLease",
          "serverId.$": "$.request.serverId",
          "ownership.$": "$.coordination.lease.ownership"
        }
      },
      "ResultPath": null,
      "Next": "Start Failed And Compensated"
    },
    "Start Failed And Compensated": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartFailedCompensated",
      "Cause": "The host start or required watchdog launch failed; the host was stopped and lifecycle state returned to stopped."
    },
    "Start Compensation Failed": {
      "Type": "Fail",
      "Error": "Spawnpoint.V2StartCompensationFailed",
      "Cause": "Host start, verified stop compensation and the final EC2 stop safeguard did not all complete; lifecycle remains stopping for explicit recovery and the running-hours alarm remains the backstop."
    }
  }
}
