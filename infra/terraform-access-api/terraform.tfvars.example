bootstrap_owner_telegram_id = "1780660807"

# Public value from BotFather -> Login Widget after adding the panel's trusted origin.
telegram_oidc_client_id = "8521897198"

# Email and password beside Telegram (ADR-0055). Set false to offer Telegram only.
password_login_enabled = true
# Open only for an intentional registration window. Existing credentials can
# still sign in while this is false.
password_registration_enabled = false
# Verification and recovery are optional adapters. `none` keeps a clone usable
# without a domain or email provider. To enable them, store the key in SSM and
# pass a sender from a domain already verified by Resend.
email_delivery_provider   = "none"
resend_api_key_parameter  = "/spawnpoint/email/resend-api-key"
email_from                = ""
email_reply_to            = ""
# Bound the public scrypt endpoints independently from normal panel traffic.
password_auth_throttling_burst_limit = 5
password_auth_throttling_rate_limit  = 2

# The SecureString is created by the bot setup and is read only at runtime.
# Never put the bot token itself in Terraform variables or state.
bot_token_parameter = "/spawnpoint/bot/token"
session_signing_secret_parameter = "/spawnpoint/auth/session-signing-secret"

# Capacity allocation (ADR-0054). The defaults are what runs today; change
# them in the rollout's order (docs/capacity-allocation-rollout.md).
# placement  = "shared"   # after the phase-10 report is in docs/acceptance/
# launch     = "enabled"  # after the Parameter Store keys in docs/runbook.md exist
# app_commit = "<commit>" # what a launched host checks out; pin the tested one
