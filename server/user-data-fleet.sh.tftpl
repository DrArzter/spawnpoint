${base}

# ---------------------------------------------------------------------------
# Fleet stage (ADR-0054, phase 12). Everything above is the base host, shared
# with the configured instance. A launched host has no data volume: the app is
# checked out here at the commit its AppCommit tag names, the runtime
# environment is rendered from Parameter Store. Connectivity is selected per
# world; the stock fleet image enables only public adapters. An overlay fleet
# needs a separate bounded-membership policy before it can be opted in.
# ---------------------------------------------------------------------------
set -Eeuo pipefail

fleet_log() {
  printf 'spawnpoint-fleet: %s\n' "$*"
}

imds_token="$(curl --silent --show-error --fail --request PUT \
  --header 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
  http://169.254.169.254/latest/api/token)"
imds() {
  curl --silent --show-error --fail --header "X-aws-ec2-metadata-token: $imds_token" "http://169.254.169.254/latest/$1"
}

region="$(imds meta-data/placement/region)"
app_commit="$(imds meta-data/tags/instance/AppCommit 2>/dev/null || true)"
[ -n "$app_commit" ] || app_commit=main
app_directory=/srv/spawnpoint/app

fleet_log "checking out $app_commit into $app_directory"
install -d -m 0755 "$app_directory" /srv/spawnpoint/system /srv/spawnpoint/runtime
if [ ! -d "$app_directory/.git" ]; then
  git init -q "$app_directory"
  git -C "$app_directory" remote add origin '${repository_url}'
fi
git -C "$app_directory" fetch -q --depth 1 origin "$app_commit"
git -C "$app_directory" checkout -q --detach FETCH_HEAD
chmod 0755 "$app_directory"/server/scripts/*.sh "$app_directory"/server/games/*/*.sh 2>/dev/null || true

fleet_log "rendering the runtime environment from ${host_parameter_path}/env"
env_file="$app_directory/server/.env"
aws ssm get-parameters-by-path --region "$region" \
  --path '${host_parameter_path}/env' --recursive --with-decryption --output json \
  | "$app_directory/server/scripts/render-host-env.sh" >"$env_file.staged"
chmod 0600 "$env_file.staged"
mv -f -- "$env_file.staged" "$env_file"

sed -i '/^SPAWNPOINT_ENABLED_CONNECTIVITY=/d; /^SPAWNPOINT_DNS_ZONE_ID=/d; /^SPAWNPOINT_DNS_SUFFIX=/d; /^SPAWNPOINT_DNS_LEDGER_TABLE=/d; /^SPAWNPOINT_INSTANCE_ID=/d' "$env_file"
printf 'SPAWNPOINT_ENABLED_CONNECTIVITY=raw,route53\n' >>"$env_file"
printf 'SPAWNPOINT_DNS_LEDGER_TABLE=%s\n' '${dns_ledger_table}' >>"$env_file"
printf 'SPAWNPOINT_INSTANCE_ID=%s\n' "$(imds meta-data/instance-id)" >>"$env_file"
%{ if game_dns_zone_id != "" ~}
printf 'SPAWNPOINT_DNS_ZONE_ID=%s\n' '${game_dns_zone_id}' >>"$env_file"
printf 'SPAWNPOINT_DNS_SUFFIX=%s\n' '${game_dns_suffix}' >>"$env_file"
%{ endif ~}

printf 'commit=%s\nready_at=%s\n' "$app_commit" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >/etc/spawnpoint-fleet-ready
fleet_log "fleet host is ready"
